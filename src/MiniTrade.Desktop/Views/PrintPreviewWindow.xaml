<Window x:Class="MiniTrade.Desktop.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        Width="1000" Height="780"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- Предпросмотр перед печатью: документ, число копий, принтер -->
    <Grid Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,10" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogCloseButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть (Esc)'}"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnClose" VerticalAlignment="Top"/>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xF1786;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PrinterText" Style="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'Копий:'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CopiesBox" Width="80" IsEditable="True"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{l:T 'Закрыть'}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnClose" MinWidth="96"/>
                            <Button Content="{l:T 'Печать'}" IsDefault="True" Click="OnPrint" Margin="8,0,0,0" MinWidth="120"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Background="#E6E8EC" Margin="12,0,12,12" CornerRadius="6" ClipToBounds="True">
                    <DocumentViewer x:Name="Viewer"/>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
