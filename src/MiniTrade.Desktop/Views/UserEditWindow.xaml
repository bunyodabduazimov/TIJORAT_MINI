<Window x:Class="MiniTrade.Desktop.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        Title="{Binding Title}" Width="800" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- Добавление и изменение пользователя (модель — UserEditViewModel) -->
    <Grid x:Name="ShadowRoom" Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,4" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть (Esc)'}"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Command="{Binding CancelCommand}" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{l:T 'Отмена'}" Style="{StaticResource SecondaryButton}" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="110" Margin="0,0,10,0"/>
                        <Button Content="{l:T 'Сохранить'}" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="130"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                    <Grid Margin="22,6,22,18">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>

                        <!-- Слева: данные и вход -->
                        <StackPanel>
                            <TextBlock Text="{l:T 'Данные пользователя'}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{l:T 'Логин *'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding User.Login, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{l:T 'ФИО *'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding User.FullName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{l:T 'Телефон'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding User.Phone, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{l:T 'Роль *'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedValuePath="Role.Id" SelectedValue="{Binding RoleId}"/>
                            <TextBlock Text="{Binding RoleSummary}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{l:T 'Примечание'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding User.Note, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"/>
                            <CheckBox Content="{l:T 'Активен (вход разрешён)'}" IsChecked="{Binding User.IsActive}" Margin="0,12,0,0"/>
                            <TextBlock Text="{l:T 'Доступ до (включительно)'}" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding AccessUntil}" l:Ui.Placeholder="{l:T 'Бессрочно'}"/>
                            <TextBlock Text="{l:T 'После этой даты вход будет запрещён. Пусто — бессрочно.'}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Справа: склады, кассы, скидка -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T 'Склады'}" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="{l:T 'Доступны все склады'}" IsChecked="{Binding AllWarehouses}"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" MaxHeight="120"
                                    Visibility="{Binding AllWarehouses, Converter={StaticResource InvBoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Warehouses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,3"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <TextBlock Text="{l:T 'Склад по умолчанию'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding DefaultWarehouseChoices}" SelectedItem="{Binding DefaultWarehouse}" DisplayMemberPath="Name"
                                      l:Ui.Placeholder="{l:T 'Не задан'}"/>

                            <TextBlock Text="{l:T 'Кассы'}" Style="{StaticResource SectionTitle}" Margin="0,20,0,0"/>
                            <CheckBox Content="{l:T 'Доступны все кассы'}" IsChecked="{Binding AllCashRegisters}"/>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" MaxHeight="120"
                                    Visibility="{Binding AllCashRegisters, Converter={StaticResource InvBoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CashRegisters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,3"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <TextBlock Text="{l:T 'Касса по умолчанию'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding DefaultCashChoices}" SelectedItem="{Binding DefaultCashRegister}" DisplayMemberPath="Name"
                                      l:Ui.Placeholder="{l:T 'Не задана'}"/>

                            <TextBlock Text="{l:T 'Продажи'}" Style="{StaticResource SectionTitle}" Margin="0,20,0,0"/>
                            <TextBlock Text="{l:T 'Максимальная скидка, %'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MaxDiscount, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left"
                                     l:Ui.Placeholder="{l:T 'Без ограничения'}"/>

                            <TextBlock Text="{l:T 'Время работы'}" Style="{StaticResource SectionTitle}" Margin="0,20,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:T 'с'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding WorkFrom, UpdateSourceTrigger=PropertyChanged}" Width="80" l:Ui.Placeholder="08:00"/>
                                <TextBlock Text="{l:T 'до'}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                <TextBox Text="{Binding WorkTo, UpdateSourceTrigger=PropertyChanged}" Width="80" l:Ui.Placeholder="18:00"/>
                            </StackPanel>
                            <TextBlock Text="{l:T 'Вне этого времени вход запрещён. Пусто — круглосуточно.'}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{l:T 'Склад и касса по умолчанию подставляются в продажу и закупку. Недоступные склады и кассы пользователь не видит и не может выбрать.'}"
                                       Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
