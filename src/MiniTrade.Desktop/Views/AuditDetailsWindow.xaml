<Window x:Class="MiniTrade.Desktop.Views.AuditDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        Width="720" SizeToContent="Height" MaxHeight="760"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- Подробности записи журнала действий -->
    <Grid Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Заголовок -->
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,8" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnClose" VerticalAlignment="Top"/>
                    <TextBlock x:Name="ActionText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleText" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <!-- Кнопки -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{l:T 'Копировать'}" Style="{StaticResource SecondaryButton}" Click="OnCopy" MinWidth="110"/>
                        <Button x:Name="OkButton" Content="OK" Click="OnClose" Margin="8,0,0,0" MinWidth="110"/>
                    </StackPanel>
                </Border>

                <!-- Сведения о записи -->
                <Grid x:Name="InfoGrid" DockPanel.Dock="Top" Margin="22,0,22,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <!-- Изменения -->
                <TextBlock DockPanel.Dock="Top" Text="{l:T 'Подробности'}" FontWeight="SemiBold" Margin="22,4,22,6"/>
                <Border Margin="22,0,22,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                        <Grid x:Name="DetailsGrid" Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
