<Window x:Class="MiniTrade.Desktop.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        Title="{l:T 'TIJORAT LITE — регистрация и активация'}" Width="924" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- Содержимое (ActivationView) пересоздаётся при смене языка — тексты {l:T} берутся при создании -->
    <ContentControl x:Name="Host" Focusable="False" IsTabStop="False"/>
</Window>
