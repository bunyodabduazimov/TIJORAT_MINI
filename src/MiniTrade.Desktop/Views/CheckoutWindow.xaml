<Window x:Class="MiniTrade.Desktop.Views.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
        xmlns:core="clr-namespace:MiniTrade.Core.Common;assembly=MiniTrade.Core"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SalesViewModel}"
        Title="{l:T 'Оформление продажи'}" Width="760" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
        Оформление продажи: слева покупатель, касса, комментарий и состав чека; справа скидка и оплата.
        F9 или Enter — провести, Esc — вернуться к чеку (чек сохраняется).
    -->
    <Window.InputBindings>
        <KeyBinding Key="F9" Command="{Binding PostSaleCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="ShadowRoom" Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Заголовок -->
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,8" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть (Esc)'}"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnCancel" VerticalAlignment="Top"/>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource SuccessLightBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xF0111;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'Оформление продажи'}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12">
                            <Run Text="{Binding ItemsCount, Mode=OneWay}"/><Run Text=" "/><Run Text="{l:T 'поз.'}"/><Run Text=" · "/><Run Text="{Binding Warehouse.Name, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Кнопки -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="OnSaveDraft" ToolTip="{l:T 'Сохранить чек и вернуться к нему позже'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF09EE;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T 'В черновики'}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{l:T 'Назад к чеку'}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancel" MinWidth="110"/>
                            <Button Style="{StaticResource SuccessButton}" IsDefault="True" Command="{Binding PostSaleCommand}" Margin="8,0,0,0" MinWidth="190">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T 'Провести продажу'}"/>
                                    <TextBlock Text="F9" Opacity="0.7" FontWeight="Normal" FontSize="12" Margin="10,1,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Margin="22,6,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Слева: кому и куда ── -->
                    <StackPanel>
                        <TextBlock Text="{l:T 'Покупатель'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF03EB;" ToolTip="{l:T 'Изменить покупателя'}" Command="{Binding EditCustomerCommand}" Visibility="{Binding Customer, Converter={StaticResource BoolToVis}}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0415;" ToolTip="{l:T 'Новый покупатель'}" Command="{Binding AddCustomerCommand}" Visibility="{Binding Customer, Converter={StaticResource InvBoolToVis}}"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name"
                                      l:Ui.Placeholder="{l:T 'Розничный покупатель'}"/>
                        </DockPanel>


                        <TextBlock Text="{l:T 'Комментарий'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="56"
                                 VerticalContentAlignment="Top" l:Ui.Placeholder="{l:T 'Необязательно'}"/>

                        <!-- Состав чека (только просмотр) -->
                        <TextBlock Text="{l:T 'Состав чека'}" Style="{StaticResource FieldLabel}"/>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" MaxHeight="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, Converter={StaticResource Money}}" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center">
                                                    <Run Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:0.###}}"/><Run Text=" × "/><Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Product.Name}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- ── Справа: сумма, скидка и оплаты ── -->
                    <StackPanel Grid.Column="2">
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{l:T 'К оплате'}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding ToPay, Converter={StaticResource Money}}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}">
                                    <Run Text="{Binding Total, Converter={StaticResource Money}, Mode=OneWay}" TextDecorations="Strikethrough"/>
                                    <Run Text="{Binding DiscountAmount, Converter={StaticResource Money}, StringFormat=−{0}, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Скидка: процент или сумма — второе поле пересчитывается -->
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Text="{l:T 'Скидка:'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Width="62"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox l:Ui.Numeric="True" TextAlignment="Right"
                                         Text="{Binding DiscountPercent, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1" Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBox Grid.Column="3" l:Ui.Numeric="True" TextAlignment="Right"
                                         Text="{Binding DiscountSum, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="4" Text="{x:Static core:Money.Currency}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </DockPanel>

                        <!-- Платежи: строки «касса — сумма». Меньше суммы — остаток в долг покупателя, больше — сдача -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Command="{Binding AddPaymentCommand}"
                                            ToolTip="{l:T 'Часть суммы оплачивается на другую кассу (карта, перевод и т.п.)'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF0415;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{l:T 'Новая оплата'}"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{l:T 'Платежи'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="PaymentsList" ItemsSource="{Binding Payments}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Left" Style="{StaticResource DangerIconButton}" Content="&#xF0A7A;" ToolTip="{l:T 'Убрать оплату'}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <TextBox DockPanel.Dock="Right" l:Ui.Numeric="True" Width="110" TextAlignment="Right" Margin="6,0,0,0"
                                                         FontSize="15" FontWeight="SemiBold"
                                                         Text="{Binding Amount, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/>
                                                <ComboBox ItemsSource="{Binding DataContext.CashRegisters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding CashRegister}" DisplayMemberPath="Name"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:T 'Нет оплат — вся сумма в долг'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"
                                           Visibility="{Binding Payments.Count, Converter={StaticResource InvBoolToVis}}"/>

                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,8,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PaidSum, Converter={StaticResource Money}}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{l:T 'Сумма оплаты'}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Remainder, Converter={StaticResource Money}}" FontWeight="SemiBold" FontSize="15"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{l:T 'Остаток'}"/><Run Text="{l:T ' (в долг)'}" Foreground="{DynamicResource DangerBrush}"
                                                     FontWeight="Normal"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,0" Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Change, Converter={StaticResource Money}}" FontWeight="SemiBold" FontSize="15"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                            <TextBlock Text="{l:T 'Сдача'}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{l:T 'Остаток записывается в долг — выберите покупателя слева'}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding CreditNeedsCustomer, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
