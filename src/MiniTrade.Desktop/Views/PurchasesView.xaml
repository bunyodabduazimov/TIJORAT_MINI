<UserControl x:Class="MiniTrade.Desktop.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PurchasesViewModel}">
    <TabControl SelectedIndex="{Binding SelectedTab}">

        <!-- ══ Оформление / изменение закупки ══ -->
        <TabItem Header="{Binding EditorTabTitle}" Visibility="{l:Can purchases.create|purchases.edit}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <!-- Режим изменения -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource InfoLightBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,10"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T 'Отменить изменение'}" Style="{StaticResource GhostButton}" Command="{Binding CancelEditCommand}"/>
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                    <Run Text="{l:T 'Изменение закупки '}"/><Run Text="{Binding EditingPurchase.Number, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{l:T '. Приход будет перепроведён, уже оплачено: '}"/><Run Text="{Binding AlreadyPaid, Mode=OneWay, Converter={StaticResource Money}}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <!-- Итог последнего проведения -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource SuccessLightBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,10"
                                Visibility="{Binding LastResult, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;" Width="24" Height="24" MinHeight="0" Padding="0"
                                        ToolTip="{l:T 'Скрыть'}" Command="{Binding DismissResultCommand}"/>
                                <TextBlock Text="&#xF012C;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,10,0"/>
                                <TextBlock Text="{Binding LastResult}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Подбор товара -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*" MinWidth="180"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{l:T 'Поиск товара'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" l:Ui.Placeholder="{l:T 'Скан + Enter'}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddByBarcodeCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{l:T 'Товар'}" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF03EB;" ToolTip="{l:T 'Изменить выбранный товар'}" Command="{Binding EditProductCommand}" Visibility="{Binding SelectedProduct, Converter={StaticResource BoolToVis}}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0415;" ToolTip="{l:T 'Новый товар'}" Command="{Binding AddProductCommand}" Visibility="{Binding SelectedProduct, Converter={StaticResource InvBoolToVis}}"/>
                                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name" l:Ui.Clearable="True"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="{l:T 'Количество'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox l:Ui.Numeric="True" Text="{Binding NewQuantity, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddLineCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="{l:T 'Закупочная цена'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox l:Ui.Numeric="True" Text="{Binding NewPrice, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddLineCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <Button Grid.Column="4" Content="{l:T 'Добавить'}" VerticalAlignment="Bottom" Command="{Binding AddLineCommand}"/>
                        </Grid>

                        <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'Товар'}" Binding="{Binding Product.Name}" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="{l:T 'Ед.'}" Binding="{Binding Product.Unit}" Width="50"/>
                                <DataGridTemplateColumn Header="{l:T 'Количество'}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBox Style="{StaticResource CellTextBox}" l:Ui.Numeric="True" Text="{Binding Quantity, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T 'Цена'}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBox Style="{StaticResource CellTextBox}" l:Ui.Numeric="True" Text="{Binding Price, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T 'Розница'}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBox Style="{StaticResource CellTextBox}" l:Ui.Numeric="True" ToolTip="{l:T 'Розничная цена — сохранится в карточке товара'}"
                                                               Text="{Binding SalePrice, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T 'Опт'}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBox Style="{StaticResource CellTextBox}" l:Ui.Numeric="True" ToolTip="{l:T 'Оптовая цена — сохранится в карточке товара'}"
                                                               Text="{Binding WholesalePrice, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T 'Сумма'}" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBox Style="{StaticResource CellTextBox}" l:Ui.Numeric="True" ToolTip="{l:T 'Сумма строки — цена закупки пересчитается'}"
                                                               Text="{Binding AmountInput, Converter={StaticResource Dec}, UpdateSourceTrigger=LostFocus}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#xF0156;" Style="{StaticResource DangerIconButton}" ToolTip="{l:T 'Удалить строку'}"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Реквизиты и оплата -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Детали закупки'}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{l:T 'Поставщик *'}" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF03EB;" ToolTip="{l:T 'Изменить поставщика'}" Command="{Binding EditSupplierCommand}" Visibility="{Binding Supplier, Converter={StaticResource BoolToVis}}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0415;" ToolTip="{l:T 'Новый поставщик'}" Command="{Binding AddSupplierCommand}" Visibility="{Binding Supplier, Converter={StaticResource InvBoolToVis}}"/>
                                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name" l:Ui.Clearable="True"/>
                            </DockPanel>
                            <TextBlock Text="{l:T 'Склад приёмки *'}" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"/>
                            </DockPanel>
                            <TextBlock Text="{l:T 'Дата документа'}" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding DocumentDate}"/>
                            <TextBlock Text="{l:T 'Комментарий'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="38" MaxHeight="80"
                                     VerticalScrollBarVisibility="Auto"/>

                            <!-- Оплата — прямо над итогом -->
                            <TextBlock Text="{l:T 'Счёт / касса'}" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <ComboBox ItemsSource="{Binding CashRegisters}" SelectedItem="{Binding CashRegister}" DisplayMemberPath="Name"/>
                            </DockPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Оплата сейчас'}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                                <TextBox l:Ui.Numeric="True" Text="{Binding PaidAmount, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{l:T 'Оплата больше суммы к оплате'}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,4,0,0"
                                           Visibility="{Binding Overpaid, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Итоги -->
                            <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Итого к оплате'}" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding Total, Converter={StaticResource Money}}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:T 'Уже оплачено'}" Style="{StaticResource Muted}"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AlreadyPaid, Converter={StaticResource Money}}"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Row="1" Text="{l:T 'Оплата сейчас'}" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PaymentNow, Converter={StaticResource Money}}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="2" Text="{l:T 'Остаток долга'}" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DebtAfter, Converter={StaticResource Money}}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Button Content="{Binding PostLabel}" Style="{StaticResource SuccessButton}" Margin="0,14,0,0" MinHeight="38" Command="{Binding PostPurchaseCommand}"/>                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- ══ Журнал закупок: период, фильтр, поиск, страницы; на всю ширину ══ -->
        <TabItem Header="{l:T 'Все закупки'}" Visibility="{l:Can purchases.history.view}">
            <Grid>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="{l:T 'Период:'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker SelectedDate="{Binding From}" Width="130"/>
                                <TextBlock Text="—" VerticalAlignment="Center" Margin="6,0"/>
                                <DatePicker SelectedDate="{Binding To}" Width="130"/>
                                <Button Style="{StaticResource InputAddonButton}" Content="&#xF0450;" ToolTip="{l:T 'Обновить'}" Command="{Binding LoadHistoryCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenFilterCommand}" MinHeight="34" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF0236;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                        <TextBlock Text="{l:T 'Фильтр'}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0"
                                                Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ActiveFilterCount}" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <TextBox Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" Width="260"
                                         l:Ui.Icon="&#xF0349;" l:Ui.Placeholder="{l:T 'Поиск: №, поставщик, комментарий'}"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Итоги и страницы -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource PagerBar}" Focusable="False" Margin="12,0,0,0"/>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" Margin="0,0,20,0"/>
                                <TextBlock Text="{l:T 'Закуплено: '}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding PeriodTotal, Converter={StaticResource Money}}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                <TextBlock Text="{l:T 'Оплачено: '}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding PeriodPaid, Converter={StaticResource Money}}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                <TextBlock Text="{l:T 'Долг: '}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding PeriodDebt, Converter={StaticResource Money}}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
                            </WrapPanel>
                        </DockPanel>

                        <!-- «⋯» — меню действий; двойной щелчок — карточка закупки в модальном окне -->
                        <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedPurchase}" HeadersVisibility="Column"
                                  l:Ui.RowNumbers="False" l:Ui.RowDoubleClickCommand="{Binding OpenPurchaseDetailsCommand}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource IconButton}" Content="&#xF0493;" FontSize="20" ToolTip="{l:T 'Действия'}" Width="28" Height="26" MinHeight="0" Padding="0"
                                                    l:Ui.DropDownMenu="True" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource DropDownMenu}">
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Изменить'}" l:Ui.Icon="&#xF0CB6;"
                                                                  Visibility="{l:Can purchases.edit}" Command="{Binding PlacementTarget.Tag.EditPurchaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Новая по образцу'}" l:Ui.Icon="&#xF018F;"
                                                                  Visibility="{l:Can purchases.create}" Command="{Binding PlacementTarget.Tag.CopyPurchaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Оплатить долг'}" l:Ui.Icon="&#xF019B;"
                                                                  Visibility="{l:Can purchases.pay}" Command="{Binding PlacementTarget.Tag.PayPurchaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Возврат поставщику'}" l:Ui.Icon="&#xF054C;" Tag="{DynamicResource WarningBrush}"
                                                                  Visibility="{l:Can purchases.return}" Command="{Binding PlacementTarget.Tag.ReturnPurchaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator Style="{StaticResource MenuSeparator}"/>
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Удалить'}" l:Ui.Icon="&#xF09E7;" Tag="{DynamicResource DangerBrush}"
                                                                  Visibility="{l:Can purchases.delete}" Command="{Binding PlacementTarget.Tag.DeletePurchaseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T 'Номер'}" Binding="{Binding Number}" Width="105"/>
                                <DataGridTextColumn Header="{l:T 'Дата'}" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="125"/>
                                <DataGridTextColumn Header="{l:T 'Поставщик'}" Binding="{Binding Supplier.Name}" Width="*" MinWidth="140"/>
                                <DataGridTextColumn Header="{l:T 'Склад'}" Binding="{Binding Warehouse.Name}" Width="110"/>
                                <DataGridTextColumn Header="{l:T 'Сумма'}" Binding="{Binding Total, Converter={StaticResource Money}}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightCell}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{l:T 'Оплачено'}" Binding="{Binding PaidAmount, Converter={StaticResource Money}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="{l:T 'Долг'}" Binding="{Binding Debt, Converter={StaticResource Money}}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightCell}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Debt}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ══ Журнал возвратов поставщикам ══ -->
        <TabItem Header="{l:T 'Возвраты поставщикам'}" Visibility="{l:Can purchases.history.view}">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{l:T 'Период:'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding ReturnsFrom}" Width="130"/>
                        <TextBlock Text="—" VerticalAlignment="Center" Margin="6,0"/>
                        <DatePicker SelectedDate="{Binding ReturnsTo}" Width="130"/>
                        <Button Style="{StaticResource InputAddonButton}" Content="&#xF0450;" ToolTip="{l:T 'Обновить'}" Command="{Binding LoadReturnsCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="{l:T 'Возвращено: '}" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding ReturnsTotal, Converter={StaticResource Money}}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                        <TextBlock Text="{l:T 'Получено денег: '}" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding ReturnsRefund, Converter={StaticResource Money}}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Returns}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T 'Номер'}" Binding="{Binding Number}" Width="110"/>
                            <DataGridTextColumn Header="{l:T 'Дата'}" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="{l:T 'Закупка'}" Binding="{Binding Purchase.Number}" Width="110"/>
                            <DataGridTextColumn Header="{l:T 'Поставщик'}" Binding="{Binding Purchase.Supplier.Name}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="{l:T 'Касса'}" Binding="{Binding CashRegister.Name}" Width="140"/>
                            <DataGridTextColumn Header="{l:T 'Причина'}" Binding="{Binding Reason}" Width="*"/>
                            <DataGridTextColumn Header="{l:T 'Сумма'}" Binding="{Binding Total, Converter={StaticResource Money}}" Width="130" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="{l:T 'Получено'}" Binding="{Binding RefundAmount, Converter={StaticResource Money}}" Width="130" ElementStyle="{StaticResource RightCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <!-- ══ Поставщики и долги: расчёты за всё время, оплата по FIFO ══ -->
        <TabItem Header="{l:T 'Расчёты с поставщиками'}" Visibility="{l:Can purchases.debts.view}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0450;" ToolTip="{l:T 'Обновить'}" Command="{Binding LoadDebtsCommand}"/>
                            <CheckBox Content="{l:T 'Только с долгом'}" IsChecked="{Binding OnlyDebtors}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <TextBlock Text="{l:T 'Общий долг поставщикам: '}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding TotalDebt, Converter={StaticResource Money}}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding SupplierDebts}" SelectedItem="{Binding SelectedDebt}"
                                  l:Ui.RowDoubleClickCommand="{Binding ShowSupplierPurchasesCommand}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'Поставщик'}" Binding="{Binding Supplier}" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="{l:T 'Телефон'}" Binding="{Binding Phone}" Width="130"/>
                                <DataGridTextColumn Header="{l:T 'Закупок'}" Binding="{Binding Documents}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="{l:T 'Последняя'}" Binding="{Binding LastDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                                <DataGridTextColumn Header="{l:T 'Сумма закупок'}" Binding="{Binding Total, Converter={StaticResource Money}}" Width="140" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="{l:T 'Оплачено'}" Binding="{Binding Paid, Converter={StaticResource Money}}" Width="140" ElementStyle="{StaticResource RightCell}"/>
                                <DataGridTextColumn Header="{l:T 'Долг'}" Binding="{Binding Debt, Converter={StaticResource Money}}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightCell}">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Оплата поставщику'}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{l:T 'Выберите поставщика с долгом в списке.'}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding HasDebtSelection, Converter={StaticResource InvBoolToVis}}"/>
                        <StackPanel Visibility="{Binding HasDebtSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedDebt.Supplier}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Долг: '}"/><Run Text="{Binding SelectedDebt.Debt, Mode=OneWay, Converter={StaticResource Money}}" Foreground="{DynamicResource WarningBrush}"/></TextBlock>
                            <TextBlock Text="{l:T 'Касса'}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CashRegisters}" SelectedItem="{Binding DebtCashRegister}" DisplayMemberPath="Name"/>
                            <TextBlock Text="{l:T 'Сумма'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox l:Ui.Numeric="True" Text="{Binding DebtPayAmount, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{l:T 'Комментарий'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding DebtComment, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{l:T 'Оплата гасит закупки поставщика начиная с самых старых.'}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Button Content="{l:T 'Оплатить'}" Style="{StaticResource SuccessButton}" Margin="0,12,0,0" MinHeight="36" Visibility="{l:Can purchases.pay}" Command="{Binding PaySupplierCommand}"/>
                        </StackPanel>
                        <Button Content="{l:T 'Закупки поставщика'}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                Command="{Binding ShowSupplierPurchasesCommand}" CommandParameter="{Binding SelectedDebt}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
