<Window x:Class="MiniTrade.Desktop.Views.OperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
        Title="{Binding Title}" Width="500" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
        Модальное окно кассовой операции. Верх формы — по типу модели (DataTemplate),
        сумма и комментарий — общие для всех операций.
    -->
    <Window.Resources>
        <!-- Приход / расход по статье -->
        <DataTemplate DataType="{x:Type vm:CashOperationViewModel}">
            <StackPanel>
                <TextBlock Text="{l:T 'Касса'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding CashRegisters}" SelectedItem="{Binding CashRegister}" DisplayMemberPath="Name"/>
                <TextBlock Text="{l:T 'Статья'}" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0415;" ToolTip="{l:T 'Новая статья'}" Command="{Binding AddArticleCommand}"/>
                    <ComboBox ItemsSource="{Binding Articles}" DisplayMemberPath="Name" Text="{Binding Article, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Перемещение между кассами -->
        <DataTemplate DataType="{x:Type vm:TransferViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:T 'Из кассы'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CashRegisters}" SelectedItem="{Binding CashRegister}" DisplayMemberPath="Name"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="&#xF0054;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:T 'В кассу'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CashRegisters}" SelectedItem="{Binding TargetCash}" DisplayMemberPath="Name"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Платёж контрагенту / от контрагента -->
        <DataTemplate DataType="{x:Type vm:CounterpartyPaymentViewModel}">
            <StackPanel>
                <TextBlock Text="{l:T 'Контрагент'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0CB6;" ToolTip="{l:T 'Изменить контрагента'}" Command="{Binding EditCounterpartyCommand}" Visibility="{Binding Counterparty, Converter={StaticResource BoolToVis}}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0415;" ToolTip="{l:T 'Новый контрагент'}" Command="{Binding AddCounterpartyCommand}" Visibility="{Binding Counterparty, Converter={StaticResource InvBoolToVis}}"/>
                    <ComboBox ItemsSource="{Binding Counterparties}" SelectedItem="{Binding Counterparty}" DisplayMemberPath="Name"/>
                </DockPanel>
                <!-- Долг по закупкам -->
                <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="6" Background="{DynamicResource InfoLightBrush}"
                        Visibility="{Binding DebtText, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DebtText}" TextWrapping="Wrap" FontSize="12"/>
                </Border>
                <TextBlock Text="{l:T 'Касса'}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding CashRegisters}" SelectedItem="{Binding CashRegister}" DisplayMemberPath="Name"/>
                <!-- Статья — только выбор из справочника; «+» — новая статья -->
                <TextBlock Text="{l:T 'Статья'}" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0415;" ToolTip="{l:T 'Новая статья'}" Command="{Binding AddArticleCommand}"/>
                    <ComboBox ItemsSource="{Binding Articles}" DisplayMemberPath="Name" SelectedValuePath="Name"
                              SelectedValue="{Binding Article}" IsEditable="False"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Начисление контрагенту (без кассы) -->
        <DataTemplate DataType="{x:Type vm:CounterpartyAccrualViewModel}">
            <StackPanel>
                <TextBlock Text="{l:T 'Контрагент'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0415;" ToolTip="{l:T 'Новый контрагент'}" Command="{Binding AddCounterpartyCommand}"/>
                    <ComboBox ItemsSource="{Binding Counterparties}" SelectedItem="{Binding Counterparty}" DisplayMemberPath="Name"/>
                </DockPanel>
                <TextBlock Text="{l:T 'Вид начисления'}" Style="{StaticResource FieldLabel}"/>
                <StackPanel IsEnabled="{Binding IsNew}">
                    <RadioButton Content="{l:T 'Мы должны контрагенту (услуги, работа, бонус)'}" IsChecked="{Binding WeOwe}" Margin="0,2,0,6"/>
                    <RadioButton Content="{l:T 'Контрагент должен нам (штраф, корректировка)'}" IsChecked="{Binding TheyOweUs}"/>
                </StackPanel>
                <TextBlock Text="{l:T 'Основание'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Article, UpdateSourceTrigger=PropertyChanged}"/>
                <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="6" Background="{DynamicResource InfoLightBrush}">
                    <TextBlock Text="{l:T 'Касса не меняется — меняется только баланс контрагента.'}" TextWrapping="Wrap" FontSize="12"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Оплата долга по закупке -->
        <DataTemplate DataType="{x:Type vm:PurchasePaymentViewModel}">
            <StackPanel>
                <Border Padding="12,10" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Purchase.Total, Converter={StaticResource Money}}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Purchase.Supplier.Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Purchase.Date, Mode=OneWay, StringFormat={}{0:dd.MM.yyyy}}"/></TextBlock>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Purchase.PaidAmount, Converter={StaticResource Money}}"/>
                            <TextBlock Text="{l:T 'Оплачено'}" Style="{StaticResource Muted}"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Purchase.Debt, Converter={StaticResource Money}}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="{l:T 'Долг'}" FontWeight="SemiBold"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{l:T 'Касса'}" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding CashRegisters}" SelectedItem="{Binding CashRegister}" DisplayMemberPath="Name"/>
            </StackPanel>
        </DataTemplate>

        <!-- Цвет кнопки проведения: расход — красный, приход — зелёный, остальное — основной -->
        <Style x:Key="SubmitButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="42"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpenseLike}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIncomeLike}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShadowRoom" Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Заголовок -->
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,8" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть (Esc)'}"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnCancel" VerticalAlignment="Top"/>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <!-- Кнопки -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{l:T 'Отмена'}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancel" MinWidth="96" MinHeight="42"/>
                        <Button Content="{Binding SubmitText}" IsDefault="True" Command="{Binding SubmitCommand}" Margin="8,0,0,0"
                                Style="{StaticResource SubmitButton}"/>
                    </StackPanel>
                </Border>

                <!-- Ошибка -->
                <Border DockPanel.Dock="Bottom" Margin="22,0,22,14" Padding="12,8" CornerRadius="6" Background="{DynamicResource DangerLightBrush}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Text="&#xF05D6;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource DangerBrush}" Margin="0,2,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <StackPanel x:Name="Form" Margin="22,4,22,18">
                    <ContentControl Content="{Binding}" Focusable="False"/>
                    <!-- Общие поля -->
                    <TextBlock Text="{l:T 'Сумма, TJS'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AmountBox" l:Ui.Numeric="True" FontSize="16" MinHeight="36" FontWeight="SemiBold"
                             Text="{Binding Amount, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{l:T 'Комментарий'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
