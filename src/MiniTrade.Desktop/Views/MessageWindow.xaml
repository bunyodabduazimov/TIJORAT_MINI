<Window x:Class="MiniTrade.Desktop.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- Сообщение / подтверждение в стиле приложения (вместо системного MessageBox) -->
    <Grid Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Заголовок -->
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,4" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogCloseButton}" Content="&#xF0156;"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnClose" VerticalAlignment="Top"/>
                    <Border x:Name="IconCircle" Width="32" Height="32" CornerRadius="16" Margin="0,0,12,0">
                        <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <!-- Кнопки -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="NoButton" Style="{StaticResource SecondaryButton}" Click="OnNo" MinWidth="96" Visibility="Collapsed"/>
                        <Button x:Name="YesButton" Click="OnYes" Margin="8,0,0,0" MinWidth="110"/>
                    </StackPanel>
                </Border>

                <!-- Поле ввода (режим Prompt) -->
                <TextBox x:Name="InputBox" DockPanel.Dock="Bottom" Margin="66,0,22,20" FontSize="16" MinHeight="36" FontWeight="SemiBold" Visibility="Collapsed"/>

                <TextBox x:Name="MessageText" Style="{StaticResource SelectableText}" TextWrapping="Wrap"
                         Margin="66,4,22,20" FontSize="14" MaxHeight="400"
                         VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
