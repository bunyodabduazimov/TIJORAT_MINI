<UserControl x:Class="MiniTrade.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
             xmlns:inf="clr-namespace:MiniTrade.Desktop.Infrastructure"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <UserControl.Resources>
        <vm:PrinterNameConverter x:Key="PrinterName"/>
        <DataTemplate x:Key="PrinterItem">
            <TextBlock Text="{Binding Converter={StaticResource PrinterName}}"/>
        </DataTemplate>
        <DataTemplate x:Key="OwnPrinterItem">
            <TextBlock Text="{Binding Converter={StaticResource PrinterName}, ConverterParameter=own}"/>
        </DataTemplate>
    </UserControl.Resources>
    <TabControl SelectedIndex="{Binding SelectedTab}">
        <!-- Компания: карточки реквизитов и учёта (право «Компания») + интерфейс этого компьютера (доступен всем) -->
        <TabItem Header="{Binding CompanyTabHeader}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>
                    <!-- Слева: одна карточка — реквизиты, параметры учёта и кнопка «Сохранить» -->
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{l:Can settings.company}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Информация о компании'}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{l:T 'Название организации *'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Company.Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{l:T 'ИНН'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Company.TaxId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{l:T 'Адрес'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Company.Address, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{l:T 'Контактный телефон'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Company.Phone, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{l:T 'Электронная почта'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Company.Email, UpdateSourceTrigger=PropertyChanged}"/>

                            <Border Height="18"/>
                            <TextBlock Text="{l:T 'Параметры учёта'}" Style="{StaticResource SectionTitle}"/>
                            <!-- 2 × 2: Страна | Валюта, Метод себестоимости | Префикс весов -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Страна'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding CountryList}" SelectedItem="{Binding Country}"
                                              ToolTip="{l:T 'Задаёт валюту и код телефона. Код подставляется в телефон нового контрагента:'}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PhoneCode}" Style="{StaticResource Muted}" Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:T 'Основная валюта'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Currencies}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Currency}"
                                              ToolTip="{l:T 'Меняется только обозначение в суммах — пересчёта по курсу нет.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="{l:T 'Метод расчёта себестоимости'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding CostingMethods}" DisplayMemberPath="Name" SelectedValuePath="Value"
                                              SelectedValue="{Binding Company.CostingMethod}"
                                              ToolTip="{l:T 'FIFO — сначала списывается товар из самых ранних приходов. Средняя — по средневзвешенной цене остатка. Смена метода действует на новые документы.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="{l:T 'Префикс весового штрихкода'}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Company.ScalePrefix, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"
                                             l:Ui.Numeric="True"
                                             ToolTip="{l:T 'Штрихкод весов из 13 цифр: 2 — код весов, 5 — код товара (штрихкод весового товара), 5 — вес в граммах, 1 — контрольная. Пусто — весы не используются.'}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="{l:T 'Разрешить отрицательные остатки'}" IsChecked="{Binding Company.AllowNegativeStock}" Margin="0,14,0,0"/>

                            <Button Content="{l:T 'Сохранить изменения'}" HorizontalAlignment="Left" MinWidth="140" Margin="0,22,0,0" Command="{Binding SaveCompanyCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Справа: интерфейс этого компьютера (ui.json, применяется сразу) -->
                    <StackPanel Grid.Column="2">
                        <!-- Карточка: тема и язык -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Интерфейс'}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{l:T 'Настройки этого компьютера. Применяются сразу.'}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                <TextBlock Text="{l:T 'Тема оформления'}" Style="{StaticResource FieldLabel}"/>
                                <UniformGrid Columns="3" Margin="0,4,0,0">
                                    <RadioButton Style="{StaticResource ChoiceTile}" GroupName="stheme" Margin="0,0,6,0"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF0379;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                            <TextBlock Text="{l:T 'Системная'}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ChoiceTile}" GroupName="stheme" Margin="3,0"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF05A8;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                            <TextBlock Text="{l:T 'Светлая'}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ChoiceTile}" GroupName="stheme" Margin="6,0,0,0"
                                                 IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF0594;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                            <TextBlock Text="{l:T 'Тёмная'}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                                <TextBlock Text="{l:T 'Язык'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/>
                                <TextBlock Text="{l:T 'Язык интерфейса программы. Окно обновится сразу, повторный вход не нужен.'}"
                                           Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Карточка: масштаб, стартовая страница, меню -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Удобство'}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{l:T 'Масштаб интерфейса'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Крупный масштаб удобен на больших мониторах и сенсорных экранах, мелкий — на ноутбуках.'}"
                                           Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{l:T 'Страница после входа'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StartPages}" SelectedItem="{Binding StartPage}" DisplayMemberPath="Name"/>
                                <CheckBox Content="{l:T 'Боковое меню свёрнуто до иконок'}" IsChecked="{Binding MenuCollapsed}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{l:T 'Пользователи'}" Visibility="{l:Can settings.users}">
            <!-- Таблица на всю ширину; добавление и изменение — в модальном окне (UserEditWindow) -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Content="{l:T '+ Новый пользователь'}"
                                Command="{Binding NewUserCommand}" IsEnabled="{Binding CanManageUsers}"/>
                        <TextBox Text="{Binding UserSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TableSearch}"
                                 inf:Ui.Placeholder="{l:T 'Поиск…'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" DataContext="{Binding UsersPager}">
                        <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource PagerBar}" Focusable="False"/>
                        <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                        <DataGrid ItemsSource="{Binding UsersPager.Items}" SelectedItem="{Binding SelectedUser}" x:Name="UsersGrid" HeadersVisibility="Column" inf:Ui.RowNumbers="False"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditUserCommand}" CommandParameter="{Binding SelectedItem, ElementName=UsersGrid}"/>
                                <KeyBinding Key="Delete" Command="{Binding DeleteUserCommand}" CommandParameter="{Binding SelectedItem, ElementName=UsersGrid}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource IconButton}" Content="&#xF0493;" FontSize="20" ToolTip="{l:T 'Действия'}" Width="28" Height="26" MinHeight="0" Padding="0"
                                                    inf:Ui.DropDownMenu="True" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    IsEnabled="{Binding DataContext.CanManageUsers, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource DropDownMenu}">
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Изменить'}" inf:Ui.Icon="&#xF0CB6;"
                                                                  Command="{Binding PlacementTarget.Tag.EditUserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Включить / отключить вход'}" inf:Ui.Icon="&#xF0342;"
                                                                  Command="{Binding PlacementTarget.Tag.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator Style="{StaticResource MenuSeparator}"/>
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Удалить'}" inf:Ui.Icon="&#xF09E7;" Tag="{DynamicResource DangerBrush}"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T 'Логин'}" Binding="{Binding Login}" Width="110"/>
                                <DataGridTextColumn Header="{l:T 'ФИО'}" Binding="{Binding FullName}" Width="*" MinWidth="140"/>
                                <DataGridTextColumn Header="{l:T 'Роль'}" Binding="{Binding AccessRole.Name}" Width="120"/>
                                <DataGridTextColumn Header="{l:T 'Телефон'}" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="{l:T 'Последний вход'}" Binding="{Binding LastLoginAt, StringFormat='dd.MM.yyyy HH:mm', TargetNullValue='—'}" Width="130"/>
                                <DataGridTextColumn Header="{l:T 'Компьютер'}" Binding="{Binding LastLoginMachine, TargetNullValue='—'}" Width="110"/>
                                <DataGridTextColumn Header="{l:T 'Входов'}" Binding="{Binding LoginCount}" Width="70"/>
                                <DataGridTextColumn Header="{l:T 'Создан'}" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" Width="90"/>
                                <DataGridTextColumn Header="{l:T 'Активен'}" Binding="{Binding IsActive, Converter={StaticResource EnumName}}" Width="70"/>
                                <DataGridTextColumn Header="{l:T 'Скидка до, %'}" Binding="{Binding MaxDiscountPercent, StringFormat='0.##', TargetNullValue='—'}" Width="100"/>
                                <DataGridTextColumn Header="{l:T 'Доступ до'}" Binding="{Binding AccessUntil, StringFormat='dd.MM.yyyy', TargetNullValue='—'}" Width="100"/>
                                <DataGridTextColumn Header="{l:T 'Время работы'}" Binding="{Binding WorkHoursText}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="{l:T 'Роли и права'}" Visibility="{l:Can settings.roles}">
            <Grid IsEnabled="{Binding CanManageRoles}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="560"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="{l:T '+ Новая роль'}" Margin="0,0,0,10" Command="{Binding NewRoleCommand}"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="{l:T 'Пользователю достаточно выбрать роль — права настраиваются здесь. Изменения действуют со следующего входа.'}"
                                   Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <DataGrid ItemsSource="{Binding RoleRows}" SelectedItem="{Binding SelectedRole}" IsReadOnly="True" HeadersVisibility="Column" inf:Ui.RowNumbers="False">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Delete" Command="{Binding DeleteRoleCommand}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource IconButton}" Content="&#xF0493;" FontSize="20" ToolTip="{l:T 'Действия'}" Width="28" Height="26" MinHeight="0" Padding="0"
                                                    inf:Ui.DropDownMenu="True" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource DropDownMenu}">
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Изменить'}" inf:Ui.Icon="&#xF0CB6;"
                                                                  Command="{Binding PlacementTarget.Tag.EditRoleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Копировать'}" inf:Ui.Icon="&#xF018F;"
                                                                  Command="{Binding PlacementTarget.Tag.CopyRoleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <Separator Style="{StaticResource MenuSeparator}"/>
                                                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Удалить'}" inf:Ui.Icon="&#xF09E7;" Tag="{DynamicResource DangerBrush}"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteRoleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T 'Роль'}" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="{l:T 'Пользователей'}" Binding="{Binding Users}" Width="110"/>
                                <DataGridTextColumn Header="{l:T 'Разрешений'}" Binding="{Binding PermissionsText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding RoleEditorTitle}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{l:T 'Название *'}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                            <DockPanel Margin="0,14,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding RoleIsAdmin, Converter={StaticResource InvBoolToVis}}">
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding ExpandToggleText}" Padding="8,2" MinHeight="0" Command="{Binding ToggleExpandPermissionsCommand}"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding CheckToggleText}" Padding="8,2" MinHeight="0" Command="{Binding ToggleCheckPermissionsCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{l:T 'Права по разделам и действиям'}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{l:T 'Администратору доступны все разделы и действия — права не ограничиваются.'}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Visibility="{Binding RoleIsAdmin, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="{l:T 'Сохранить роль'}" Margin="0,12,0,0" Command="{Binding SaveRoleCommand}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding RoleIsAdmin, Converter={StaticResource Not}}">
                            <ItemsControl ItemsSource="{Binding PermissionModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Дерево прав: модуль ▸ подраздел ▸ действия. Флажок узла включает/снимает все вложенные -->
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsExpanded}" Style="{StaticResource TreeChevron}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Counter}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding AllChecked}" IsThreeState="True" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <StackPanel Margin="26,2,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="24,0,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,3,18,3"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Подразделы (вкладки) модуля -->
                                                    <ItemsControl ItemsSource="{Binding Groups}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,2,0,0">
                                                                    <DockPanel>
                                                                        <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding IsExpanded}" Style="{StaticResource TreeChevron}"/>
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Counter}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding AllChecked}" IsThreeState="True" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="50,0,0,4"
                                                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,3,18,3"/>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="{l:T 'Печать и документы'}" Visibility="{l:Can settings.print}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- Слева: принтеры и вид документов -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshPrintersCommand}"
                                            VerticalAlignment="Top" ToolTip="{l:T 'Обновить список принтеров'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x21BB;" Margin="0,0,6,0"/>
                                            <TextBlock Text="{l:T 'Обновить'}"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{l:T 'Принтеры'}" Style="{StaticResource SectionTitle}" Margin="0"/>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="{Binding PrintersInfo}"/>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel VerticalAlignment="Center" Margin="0,4,12,4">
                                        <TextBlock Text="{l:T 'Основной'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{l:T 'ордера и прочее'}" Style="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding Printers}" SelectedItem="{Binding PrinterName}" ItemTemplate="{StaticResource PrinterItem}"/>

                                    <TextBlock Grid.Row="1" Text="{l:T 'Чеки'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Printers}" SelectedItem="{Binding ReceiptPrinterName}" ItemTemplate="{StaticResource OwnPrinterItem}"/>

                                    <TextBlock Grid.Row="2" Text="{l:T 'Накладные'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Printers}" SelectedItem="{Binding InvoicePrinterName}" ItemTemplate="{StaticResource OwnPrinterItem}"/>

                                    <TextBlock Grid.Row="3" Text="{l:T 'Этикетки'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Printers}" SelectedItem="{Binding LabelPrinterName}" ItemTemplate="{StaticResource OwnPrinterItem}"/>
                                </Grid>

                                <Separator Margin="0,12,0,4" Opacity="0.4"/>
                                <CheckBox Content="{l:T 'Показывать предпросмотр перед печатью'}" IsChecked="{Binding ShowPrintPreview}" Margin="0,8,0,0"/>
                                <CheckBox Content="{l:T 'Печатать сразу, без окна выбора принтера'}" IsChecked="{Binding PrintWithoutDialog}" Margin="0,8,0,0"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="{l:T 'Например: чеки — на термопринтер 80 мм, накладные — на офисный A4, этикетки — на принтер этикеток.'}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <TabControl SelectedIndex="{Binding PrintSection}">
                                <TabItem Header="{l:T 'Чек'}">
                                    <StackPanel DataContext="{Binding Receipt}" Margin="0,4,0,0">
                                        <TextBlock Text="{l:T 'Бумага'}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.ReceiptFormats, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Format}"/>
                                        <TextBlock Text="{l:T 'Заголовок'}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="{l:T 'Размер шрифта'}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox ItemsSource="{Binding DataContext.FontSizes, RelativeSource={RelativeSource AncestorType=TabControl}}" SelectedItem="{Binding FontSize}"/>
                                            </StackPanel>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="{l:T 'Копий'}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox ItemsSource="{Binding DataContext.CopyOptions, RelativeSource={RelativeSource AncestorType=TabControl}}" SelectedItem="{Binding Copies}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="{l:T 'Показывать'}" Style="{StaticResource FieldLabel}"/>
                                        <CheckBox Content="{l:T 'Реквизиты компании (ИНН, адрес, телефон)'}" IsChecked="{Binding ShowCompanyDetails}"/>
                                        <CheckBox Content="{l:T 'Покупателя'}" IsChecked="{Binding ShowCustomer}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Артикул товара'}" IsChecked="{Binding ShowSku}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Строку для подписи продавца'}" IsChecked="{Binding ShowSignature}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Текст внизу чека'}" IsChecked="{Binding ShowFooter}" Margin="0,8,0,0"/>
                                        <TextBlock Text="{l:T 'Текст внизу чека'}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding DataContext.Company.ReceiptFooter, RelativeSource={RelativeSource AncestorType=TabControl}, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                        <TextBlock Text="{l:T 'Например: «Спасибо за покупку! Обмен и возврат — в течение 14 дней при наличии чека».'}"
                                                   Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <Button Content="{l:T 'Сохранить текст'}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Command="{Binding DataContext.SaveCompanyCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                                                   Text="{l:T 'Реквизиты задаются на вкладке «Компания». Для термопринтера выберите чековую ленту — чек печатается по длине содержимого.'}"/>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="{l:T 'Накладная'}">
                                    <StackPanel DataContext="{Binding Invoice}" Margin="0,4,0,0">
                                        <TextBlock Text="{l:T 'Заголовок'}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="{l:T 'Размер шрифта'}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox ItemsSource="{Binding DataContext.FontSizes, RelativeSource={RelativeSource AncestorType=TabControl}}" SelectedItem="{Binding FontSize}"/>
                                            </StackPanel>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="{l:T 'Копий'}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox ItemsSource="{Binding DataContext.CopyOptions, RelativeSource={RelativeSource AncestorType=TabControl}}" SelectedItem="{Binding Copies}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <CheckBox Content="{l:T 'Альбомная ориентация листа'}" IsChecked="{Binding Landscape}" Margin="0,14,0,0"/>
                                        <TextBlock Text="{l:T 'Показывать'}" Style="{StaticResource FieldLabel}"/>
                                        <CheckBox Content="{l:T 'Реквизиты поставщика'}" IsChecked="{Binding ShowCompanyDetails}"/>
                                        <CheckBox Content="{l:T 'Колонку «Артикул»'}" IsChecked="{Binding ShowSku}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Колонку «Штрихкод»'}" IsChecked="{Binding ShowBarcode}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Сумму прописью'}" IsChecked="{Binding ShowAmountInWords}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Примечание к продаже'}" IsChecked="{Binding ShowComment}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Подписи «Отпустил / Получил» и М.П.'}" IsChecked="{Binding ShowSignatures}" Margin="0,8,0,0"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                                                   Text="{l:T 'Накладная печатается из журнала продаж: ⚙ в строке → «Печать накладной».'}"/>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="{l:T 'Этикетка'}">
                                    <StackPanel DataContext="{Binding Label}" Margin="0,4,0,0">
                                        <TextBlock Text="{l:T 'Размер этикетки, мм'}" Style="{StaticResource FieldLabel}"/>
                                        <ItemsControl ItemsSource="{Binding DataContext.LabelPresets, RelativeSource={RelativeSource AncestorType=TabControl}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" MinWidth="0" Padding="10,4"
                                                            Command="{Binding DataContext.ApplyLabelPresetCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="{l:T 'Ширина, мм'}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding WidthMm, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="{l:T 'Высота, мм'}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding HeightMm, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="{l:T 'Шрифт названия'}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox ItemsSource="{Binding DataContext.FontSizes, RelativeSource={RelativeSource AncestorType=TabControl}}" SelectedItem="{Binding NameFontSize}"/>
                                            </StackPanel>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="{l:T 'Шрифт цены'}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox ItemsSource="{Binding DataContext.FontSizes, RelativeSource={RelativeSource AncestorType=TabControl}}" SelectedItem="{Binding PriceFontSize}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="{l:T 'Показывать'}" Style="{StaticResource FieldLabel}"/>
                                        <CheckBox Content="{l:T 'Название компании'}" IsChecked="{Binding ShowCompany}"/>
                                        <CheckBox Content="{l:T 'Наименование товара'}" IsChecked="{Binding ShowName}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Артикул'}" IsChecked="{Binding ShowSku}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Цену'}" IsChecked="{Binding ShowPrice}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Штрихкод'}" IsChecked="{Binding ShowBarcode}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Цифры под штрихкодом'}" IsChecked="{Binding ShowBarcodeText}" Margin="0,8,0,0"/>
                                        <CheckBox Content="{l:T 'Дату печати'}" IsChecked="{Binding ShowDate}" Margin="0,8,0,0"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                                                   Text="{l:T 'Штрихкод (Code 128) берётся из карточки товара, если он пуст — артикул. Печать: Справочники → Товары → «Этикетка».'}"/>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Справа: образец с текущими настройками -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetPrintSectionCommand}" Margin="0,0,8,0"
                                        Content="{l:T 'Сбросить'}" ToolTip="{l:T 'Вернуть настройки этого документа по умолчанию'}"/>
                                <Button Command="{Binding PrintSampleCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF1786;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                        <TextBlock Text="{l:T 'Пробная печать'}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Предпросмотр'}" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                    <Run Text="&#x1F5A8;"/> <Run Text="{Binding PreviewInfo, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <!-- Своя компактная панель масштаба вместо стандартной панели DocumentViewer -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="−" MinWidth="0" Padding="12,4" Click="OnZoomOut" ToolTip="{l:T 'Уменьшить'}"/>
                                <TextBlock x:Name="ZoomText" Width="56" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="+" MinWidth="0" Padding="12,4" Click="OnZoomIn" ToolTip="{l:T 'Увеличить'}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'По размеру'}" Margin="8,0,0,0" Padding="12,4" Click="OnZoomFit"/>
                            </StackPanel>
                            <TextBlock Text="{l:T 'Образец с реквизитами вашей компании — меняется сразу. Ctrl + колесо мыши — масштаб.'}"
                                       Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border Background="#E6E8EC" CornerRadius="6" ClipToBounds="True">
                            <DocumentViewer x:Name="PreviewViewer" Document="{Binding PrintPreview}" Background="#E6E8EC"/>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- Кассовый аппарат: фискальный принтер Fiscat этого компьютера -->
        <TabItem Header="{l:T 'Кассовое оборудование'}" Visibility="{Binding ShowFiscalTab, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:T 'Фискальный принтер Fiscat'}" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="{l:T 'Пробивать чеки продаж и возвратов на ККТ'}" IsChecked="{Binding FiscalEnabled}" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T 'Выключено — продажи проводятся без ККТ. Настройка хранится на этом компьютере.'}"
                                   Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T 'IP-адрес ККТ *'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FiscalHost, UpdateSourceTrigger=PropertyChanged}" l:Ui.Placeholder="192.168.1.100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T 'Порт'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FiscalPort, UpdateSourceTrigger=PropertyChanged}" l:Ui.Numeric="True"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:T 'Система налогообложения'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding FiscalTaxTypes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding FiscalTaxType}"/>
                        <TextBlock Text="{l:T 'Ставка НДС товаров'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding FiscalVatCodes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding FiscalVatCode}"/>
                        <CheckBox Content="{l:T 'Печатать бумажный чек'}" IsChecked="{Binding FiscalPrintSlip}" Margin="0,14,0,0"/>
                        <CheckBox Content="{l:T 'Открывать денежный ящик при оплате наличными'}" IsChecked="{Binding FiscalOpenDrawer}" Margin="0,8,0,0"/>
                        <TextBlock Text="{l:T 'Безналичная оплата — оплата в кассы с флажком «Безналичная касса» (Справочники → Кассы). Смена открывается автоматически при первом чеке.'}"
                                   Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <Button Content="{l:T 'Сохранить'}" HorizontalAlignment="Left" Width="140" Margin="0,20,0,0" Command="{Binding SaveFiscalCommand}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" IsEnabled="{Binding FiscalBusy, Converter={StaticResource Not}}">
                        <TextBlock Text="{l:T 'Операции'}" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Проверить связь'}" Margin="0,0,8,8" Command="{Binding FiscalCheckCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Открыть смену'}" Margin="0,0,8,8" Command="{Binding FiscalOpenShiftCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'X-отчёт'}" Margin="0,0,8,8" Command="{Binding FiscalXReportCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Закрыть смену (Z-отчёт)'}" Margin="0,0,8,8" Command="{Binding FiscalCloseShiftCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Внесение наличных'}" Margin="0,0,8,8" Command="{Binding FiscalAddCashCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Изъятие наличных'}" Margin="0,0,8,8" Command="{Binding FiscalRemoveCashCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Повтор последнего ФД'}" Margin="0,0,8,8" Command="{Binding FiscalPrintLastCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{l:T 'Открыть денежный ящик'}" Margin="0,0,8,8" Command="{Binding FiscalOpenDrawerCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding FiscalStatus}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{l:T 'Данные и резервные копии'}" Visibility="{l:Can settings.database}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- Слева база и подключение, справа — резервное копирование -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="680"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MaxWidth="680"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top">
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{l:T 'Текущая база данных'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{l:T 'Все торговые, складские и финансовые данные хранятся локально в SQLite и не передаются на сервер.'}" TextWrapping="Wrap" Style="{StaticResource Muted}"
                               Visibility="{Binding IsLocalDatabase, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{l:T 'Данные хранятся на сервере MySQL и доступны всем подключённым компьютерам. Копию можно сохранить вручную в виде SQL-дампа.'}" TextWrapping="Wrap" Style="{StaticResource Muted}"
                               Visibility="{Binding IsRemoteDatabase, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{l:T 'Расположение'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="{l:T 'Создать копию сейчас'}" Command="{Binding BackupNowCommand}" Margin="0,0,10,0"/>
                        <Button Content="{l:T 'Сохранить копию как…'}" Style="{StaticResource SecondaryButton}" Command="{Binding BackupCommand}" Margin="0,0,10,0"/>
                        <Button Content="{l:T 'Восстановить из копии…'}" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanManageDatabase}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel IsEnabled="{Binding CanManageDatabase}">
                    <TextBlock Text="{l:T 'Подключение к базе данных'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{l:T 'Для работы с нескольких компьютеров подключите общую базу на сервере MySQL. Изменения применяются после перезапуска программы.'}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                    <RadioButton GroupName="dbmode" Content="{l:T 'Локальная база SQLite на этом компьютере'}" Margin="0,0,0,8"
                                 IsChecked="{Binding UseLocalDb}"/>
                    <RadioButton GroupName="dbmode" Content="{l:T 'Удалённый сервер MySQL'}" IsChecked="{Binding UseRemoteDb}"/>
                    <StackPanel Visibility="{Binding UseRemoteDb, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Сервер (host)'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding DbHost, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T 'Порт'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding DbPort, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:T 'База данных'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DbName, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Пользователь'}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T 'Пароль'}" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox l:PasswordBinding.Value="{Binding DbPassword}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="{l:T 'Сохранить и перезапустить'}" Command="{Binding SaveDatabaseCommand}" Margin="0,0,10,0"/>
                        <Button Content="{l:T 'Проверить подключение'}" Style="{StaticResource SecondaryButton}" Command="{Binding TestDatabaseCommand}"
                                Visibility="{Binding UseRemoteDb, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="{l:T 'Если база на сервере пустая, таблицы создаются автоматически при первом подключении. Пароль сохраняется в зашифрованном виде.'}"/>
                </StackPanel>
            </Border>

            <!-- Журнал ошибок: текстовые файлы по дням -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,16">
                <StackPanel>
                    <TextBlock Text="{l:T 'Журнал ошибок'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{l:T 'Папка журналов'}" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:T 'Сегодняшний файл'}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding OpenTodayErrorLogCommand}"/>
                        <Button DockPanel.Dock="Right" Content="{l:T 'Открыть'}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding OpenErrorLogFolderCommand}"/>
                        <TextBox Text="{Binding ErrorLogFolder, Mode=OneWay}" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" Text="{Binding ErrorLogHint}"/>
                </StackPanel>
            </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:T 'Резервное копирование'}" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Content="{l:T 'Автоматически создавать копию при выходе из программы'}" IsChecked="{Binding AutoBackup}"
                              Visibility="{Binding IsLocalDatabase, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{l:T 'Папка резервных копий'}" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:T 'Открыть'}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding OpenBackupFolderCommand}"/>
                        <Button DockPanel.Dock="Right" Content="{l:T 'Изменить…'}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding ChooseBackupFolderCommand}"/>
                        <TextBox Text="{Binding BackupFolder, Mode=OneWay}" IsReadOnly="True"/>
                    </DockPanel>
                    <StackPanel Visibility="{Binding IsLocalDatabase, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{l:T 'Хранить последних автокопий'}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding KeepOptions}" SelectedItem="{Binding BackupKeep}" Width="120" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Text="{l:T 'Хранить копии (дней)'}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding BackupKeepDays, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <TextBlock Text="{l:T '0 — хранить бессрочно'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="{l:T 'Последняя копия:'}" Style="{StaticResource Muted}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LastBackup}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="{l:T 'Совет: укажите папку на другом диске, флешке или в облачной папке (OneDrive, Google Диск), чтобы не потерять данные при поломке компьютера.'}"/>
                </StackPanel>
            </Border>

            <!-- Полная очистка базы: только администратор, с паролем и обязательной резервной копией -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{DynamicResource DangerBrush}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Очистка базы данных'}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="{l:T 'Удаляет все данные: товары, документы, контрагентов, кассы, пользователей и настройки. База станет как новая — вход: admin / admin. Перед очисткой автоматически создаётся резервная копия; без неё очистка не выполняется.'}"/>
                    <TextBlock Text="{l:T 'Пароль администратора'}" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox l:PasswordBinding.Value="{Binding WipePassword}"/>
                    <CheckBox Content="{l:T 'Я понимаю, что все данные будут удалены'}" IsChecked="{Binding WipeConfirmed}" Margin="0,12,0,0"/>
                    <Button Content="{l:T 'Очистить базу данных'}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding WipeDatabaseCommand}"/>
                </StackPanel>
            </Border>

            <!-- Демо-данные: пустая база заполняется демо-компанией выбранного направления -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Демо-данные'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="{l:T 'Заполняет пустую базу демо-компанией: реалистичные товары, клиенты, поставщики и год работы — продажи, закупки, оплаты, долги, расходы. Только для пустой базы (сначала очистите её). Займёт около минуты.'}"/>
                    <TextBlock Text="{l:T 'Направление'}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DemoChoices}" SelectedItem="{Binding SelectedDemo}" IsEnabled="{Binding DemoRunning, Converter={StaticResource Not}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource PrimaryBrush}" Margin="0,1,8,0"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description, StringFormat=' — {0}'}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{l:T 'Пароль администратора'}" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox l:PasswordBinding.Value="{Binding DemoPassword}"/>
                    <Button Content="{l:T 'Заполнить демо-данными'}" HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding FillDemoCommand}"/>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding DemoRunning, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding DemoProgress}" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource SurfaceAltBrush}"/>
                        <TextBlock Text="{Binding DemoStep}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
            </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{l:T 'Лицензия и подписка'}" Visibility="{l:Can settings.license}">
            <Border Style="{StaticResource Card}" Width="620" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{l:T 'Лицензия'}" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:T 'Тип'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding LicenseType}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="{l:T 'Ключ'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LicenseKey, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Text="{l:T 'Владелец'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseOwner}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Text="{l:T 'Срок действия'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LicenseTerm}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Text="{l:T 'Состояние'}" Style="{StaticResource Muted}" Margin="0,6"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LicenseStatus}" TextWrapping="Wrap" Margin="0,6"/>
                        <TextBlock Grid.Row="5" Text="{l:T 'Последняя онлайн-проверка'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastCheck}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="6" Text="{l:T 'ID установки'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding InstallationId, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="7" Text="{l:T 'Сервер лицензий'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ServerUrl}" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="{l:T 'Проверить онлайн'}" Command="{Binding CheckLicenseCommand}"/>
                        <Button Content="{l:T 'Ввести новый ключ'}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding EnterNewKeyCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="{l:T 'После активации программа работает офлайн. Онлайн-проверка выполняется при запуске; без связи с сервером лицензия действует до 30 дней.'}"/>
                </StackPanel>
            </Border>
        </TabItem>

        <!-- О программе: версия, контакты, другие приложения (контакты — appsettings.json → "About") -->
        <TabItem Header="{l:T 'О программе'}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,0" DataContext="{x:Static inf:AboutInfo.Current}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.Resources>
                    <DataTemplate x:Key="AppLinkTemplate">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" VerticalAlignment="Center"
                                    Command="{Binding OpenCommand, Source={x:Static inf:AboutInfo.Current}}" CommandParameter="{Binding Url}"/>
                            <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,12,0">
                                <Grid>
                                    <TextBlock Text="&#xF0BAF;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasLogo, Converter={StaticResource InvBoolToVis}}"/>
                                    <Image Source="{Binding LogoImage}" Width="30" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                           Visibility="{Binding Description, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                    <Style x:Key="BizItem" TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                    </Style>
                </Grid.Resources>

                <!-- 1. О программе и для какого бизнеса -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Margin="0,0,18,0" VerticalAlignment="Top">
                            <Image Source="{StaticResource LogoFull}" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                <Run Text="{l:T 'Версия'}"/> <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Runtime}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{l:T 'Простая программа учёта продаж, закупок, склада и денег для малого и среднего бизнеса.'}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <TextBlock Text="{l:T 'Подходит для:'}" FontWeight="SemiBold" Margin="0,12,0,8"/>
                    <UniformGrid Columns="2">
                        <TextBlock Style="{StaticResource BizItem}" Text="{l:T '• Магазины и минимаркеты'}"/>
                        <TextBlock Style="{StaticResource BizItem}" Text="{l:T '• Продуктовые и весовые товары'}"/>
                        <TextBlock Style="{StaticResource BizItem}" Text="{l:T '• Одежда и обувь'}"/>
                        <TextBlock Style="{StaticResource BizItem}" Text="{l:T '• Хозтовары и стройматериалы'}"/>
                        <TextBlock Style="{StaticResource BizItem}" Text="{l:T '• Электроника и аксессуары'}"/>
                        <TextBlock Style="{StaticResource BizItem}" Text="{l:T '• Аптеки и косметика'}"/>
                        <TextBlock Style="{StaticResource BizItem}" Text="{l:T '• Автозапчасти'}"/>
                        <TextBlock Style="{StaticResource BizItem}" Text="{l:T '• Оптовые склады и дистрибуция'}"/>
                        <TextBlock Style="{StaticResource BizItem}" Text="{l:T '• Сфера услуг — любые виды услуг'}"/>
                    </UniformGrid>
                  </StackPanel>
                </Border>

                <!-- 2. Контакты -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Связаться с нами'}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{l:T 'Вопросы, предложения, техническая поддержка.'}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <WrapPanel.Resources>
                                <!-- Круглый значок в фирменном цвете сервиса -->
                                <Style x:Key="BrandBadge" TargetType="Border">
                                    <Setter Property="Width" Value="22"/>
                                    <Setter Property="Height" Value="22"/>
                                    <Setter Property="CornerRadius" Value="11"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="BrandGlyph" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Margin" Value="0,0,10,10"/>
                                    <Setter Property="Command" Value="{Binding OpenCommand, Source={x:Static inf:AboutInfo.Current}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                                    <Style.Triggers>
                                        <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                        <Trigger Property="Tag" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Resources>
                            <Button Tag="{Binding Website}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource BrandBadge}" Background="#2F6FED"><TextBlock Text="&#xF059F;" Style="{StaticResource BrandGlyph}"/></Border>
                                    <TextBlock Text="{l:T 'Сайт'}"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="{Binding Phone}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource BrandBadge}" Background="#25A244"><TextBlock Text="&#xF03F2;" Style="{StaticResource BrandGlyph}"/></Border>
                                    <TextBlock Text="{Binding Phone}"/>
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding Phones}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource BrandBadge}" Background="#25A244"><TextBlock Text="&#xF03F2;" Style="{StaticResource BrandGlyph}"/></Border>
                                                <TextBlock Text="{Binding}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Tag="{Binding Email}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource BrandBadge}" Background="#EA4335"><TextBlock Text="&#xF01EE;" Style="{StaticResource BrandGlyph}"/></Border>
                                    <TextBlock Text="{Binding Email}"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="{Binding Telegram}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource BrandBadge}" Background="#229ED9"><Path Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,1,0" Data="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></Border>
                                    <TextBlock Text="Telegram"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="{Binding WhatsAppLink}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource BrandBadge}" Background="#25D366"><TextBlock Text="&#xF05A3;" Style="{StaticResource BrandGlyph}"/></Border>
                                    <TextBlock Text="WhatsApp"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="{Binding Instagram}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource BrandBadge}"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#FEDA75" Offset="0"/><GradientStop Color="#FA7E1E" Offset="0.25"/><GradientStop Color="#D62976" Offset="0.5"/><GradientStop Color="#962FBF" Offset="0.75"/><GradientStop Color="#4F5BD5" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xF02FE;" Style="{StaticResource BrandGlyph}"/></Border>
                                    <TextBlock Text="Instagram"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="{Binding Facebook}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource BrandBadge}" Background="#1877F2"><TextBlock Text="&#xF020C;" Style="{StaticResource BrandGlyph}"/></Border>
                                    <TextBlock Text="Facebook"/>
                                </StackPanel>
                            </Button>
                            <Button Tag="{Binding TikTok}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource BrandBadge}" Background="#000000"><TextBlock Text="&#xF0387;" Style="{StaticResource BrandGlyph}"/></Border>
                                    <TextBlock Text="TikTok"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                    <!-- 3. Другие наши приложения -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Другие наши приложения'}" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding Apps}" Margin="0,6,0,0" Tag="{l:T 'Открыть'}" ItemTemplate="{StaticResource AppLinkTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Удалённый доступ -->
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding HasRemoteApps, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Удалённый доступ'}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{l:T 'Установите одну из программ, чтобы специалист поддержки мог подключиться к вашему компьютеру.'}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding RemoteApps}" Tag="{l:T 'Скачать'}" ItemTemplate="{StaticResource AppLinkTemplate}"/>
                        </StackPanel>
                    </Border>
            </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
