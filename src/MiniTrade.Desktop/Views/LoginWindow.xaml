<Window x:Class="MiniTrade.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
        xmlns:inf="clr-namespace:MiniTrade.Desktop.Infrastructure"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LoginViewModel}"
        Title="{l:T 'TIJORAT LITE — вход'}" Width="904" Height="568"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=Pwd}">
    <Window.Resources>
        <Style x:Key="Feature" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE5FA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FeatureIcon" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <!-- Поля входа чуть крупнее обычных -->
        <Style x:Key="LoginFieldText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="LoginFieldPassword" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0,40,0"/>
        </Style>
        <!-- «Глаз» внутри поля пароля -->
        <Style x:Key="PasswordEye" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <TextBlock x:Name="Eye" Text="&#xF06D0;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Eye" Property="Text" Value="&#xF06D1;"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Поля по краям — место для тени; перетаскивание за любое пустое место -->
    <Grid Margin="22" MouseLeftButtonDown="OnDrag">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ══════ Левая панель: бренд ══════ -->
                <Border CornerRadius="14,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2F6FED" Offset="0"/>
                            <GradientStop Color="#1E46B0" Offset="0.5"/>
                            <GradientStop Color="#141B2D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ClipToBounds="True">
                        <!-- Декоративные круги (не касаются скруглённых углов слева) -->
                        <Ellipse Width="300" Height="300" Fill="#12FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-130,-150,0"/>
                        <Ellipse Width="190" Height="190" Fill="#0DFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-60"/>
                        <Ellipse Width="70" Height="70" Stroke="#24FFFFFF" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,46,90"/>

                        <DockPanel Margin="36,34,36,30">
                            <!-- Полный логотип на белой плашке: синий текст логотипа не теряется на синем фоне -->
                            <Border DockPanel.Dock="Top" HorizontalAlignment="Left" CornerRadius="12" Background="White" Padding="14,10">
                                <Image Source="{StaticResource LogoFull}" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <TextBlock DockPanel.Dock="Bottom" Text="{l:T 'Данные хранятся локально на этом компьютере'}" Foreground="#93A5D3" FontSize="11"/>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="{l:T 'Торговля, склад и деньги — в одном окне'}" Foreground="White" FontSize="24" FontWeight="SemiBold"
                                           TextWrapping="Wrap" LineHeight="32"/>
                                <TextBlock Text="{l:T 'Быстрые продажи по штрихкоду, учёт остатков и касс без лишних шагов.'}" Foreground="#C5D3F3"
                                           FontSize="13" TextWrapping="Wrap" Margin="0,10,0,26"/>

                                <DockPanel Margin="0,0,0,12">
                                    <Border Style="{StaticResource FeatureIcon}">
                                        <TextBlock Text="&#xF0111;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{l:T 'Продажи, возвраты и закупки'}" Style="{StaticResource Feature}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Border Style="{StaticResource FeatureIcon}">
                                        <TextBlock Text="&#xF03D7;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{l:T 'Склады, остатки и инвентаризация'}" Style="{StaticResource Feature}"/>
                                </DockPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource FeatureIcon}">
                                        <TextBlock Text="&#xF0127;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{l:T 'Кассы, финансы и отчёты'}" Style="{StaticResource Feature}"/>
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- ══════ Правая панель: форма входа ══════ -->
                <Grid Grid.Column="1">
                    <Button Style="{StaticResource IconButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть'}" Width="32" Height="32"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" IsTabStop="False" Click="OnClose"/>

                    <StackPanel Width="330" VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'Добро пожаловать'}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T 'Войдите, чтобы продолжить работу'}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,18"/>

                        <TextBlock Text="{l:T 'Логин'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="LoginBox" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LoginFieldText}"
                                 inf:Ui.Icon="&#xF0004;" inf:Ui.Placeholder="{l:T 'Введите логин'}"/>

                        <TextBlock Text="{l:T 'Пароль'}" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <PasswordBox x:Name="Pwd" Style="{StaticResource LoginFieldPassword}" inf:Ui.Icon="&#xF033E;"
                                         PreviewKeyDown="OnPasswordKey" PreviewKeyUp="OnPasswordKey" GotKeyboardFocus="OnPasswordFocus"/>
                            <TextBox x:Name="PwdVisible" Style="{StaticResource LoginFieldText}" inf:Ui.Icon="&#xF033E;" Padding="10,0,40,0"
                                     Visibility="Collapsed" PreviewKeyDown="OnPasswordKey" PreviewKeyUp="OnPasswordKey"/>
                            <ToggleButton x:Name="ShowPwd" Style="{StaticResource PasswordEye}" HorizontalAlignment="Right" Margin="0,0,6,0"
                                          ToolTip="{l:T 'Показать пароль'}" Checked="OnShowPassword" Unchecked="OnShowPassword"/>
                        </Grid>
                        <StackPanel x:Name="CapsWarning" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                            <TextBlock Text="&#xF002A;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,1,6,0"/>
                            <TextBlock Text="{l:T 'Включён Caps Lock'}" FontSize="12" Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>

                        <CheckBox Content="{l:T 'Запомнить пароль'}" IsChecked="{Binding RememberPassword}" Margin="0,12,0,0"
                                  ToolTip="{l:T 'Логин и пароль сохранятся на этом компьютере в зашифрованном виде'}"/>

                        <Border Margin="0,14,0,0" Padding="12,9" CornerRadius="8" Background="{DynamicResource DangerLightBrush}"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock Text="&#xF05D6;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource DangerBrush}" Margin="0,2,8,0"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>

                        <Button IsDefault="True" Click="OnSignIn" Margin="0,20,0,0" MinHeight="42" FontSize="14"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:T 'Войти'}" Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}"/>
                                <TextBlock Text="{l:T 'Вход…'}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="&#xF0342;" FontFamily="{StaticResource IconFont}" FontSize="18" Margin="10,1,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}"/>
                            </StackPanel>
                        </Button>

                        <Border Margin="0,22,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"
                                Visibility="{Binding ShowFirstLoginHint, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock Text="&#xF02FC;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,2,10,0"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap">
                                    <Run Text="{l:T 'Первый вход:'}"/> <Run Text="admin / admin" FontWeight="SemiBold"/><Run Text="{l:T '. Смените пароль в разделе «Настройки».'}"/>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" Style="{StaticResource Muted}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
