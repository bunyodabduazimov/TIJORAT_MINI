<UserControl x:Class="MiniTrade.Desktop.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
             xmlns:inf="clr-namespace:MiniTrade.Desktop.Infrastructure"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CatalogViewModel}">
    <!--
        Каждая вкладка — таблица на всю ширину (DataContext — CatalogEditor<T>).
        Добавление и изменение открывают модальное окно (ICatalogDialogs):
        «+ Добавить», двойной клик по строке или ✎ в строке.
    -->
    <UserControl.Resources>
        <!-- Панель над таблицей: слева «Добавить» · справа архив, поиск, страницы -->
        <DataTemplate x:Key="Toolbar">
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Left" Content="{l:T '+ Добавить'}" Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}" Command="{Binding NewCommand}"/>
                <!-- Доп. кнопки вкладки (Этикетка, Импорт/экспорт) — сразу после «Добавить» -->
                <ContentPresenter DockPanel.Dock="Left" Content="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="{l:T 'Показывать архив'}" IsChecked="{Binding ShowArchived}" VerticalAlignment="Center" Margin="0,0,12,0"
                              Visibility="{Binding SupportsFilter, Converter={StaticResource InvBoolToVis}}"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenFilterCommand}" Margin="0,0,8,0"
                            Visibility="{Binding SupportsFilter, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF0236;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="{l:T 'Фильтр'}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0"
                                    Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ActiveFilterCount}" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TableSearch}" inf:Ui.Placeholder="{l:T 'Поиск…'}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Под таблицей: «Показано X–Y из N» слева, страницы справа -->
        <DataTemplate x:Key="Pager">
            <DockPanel Margin="0,10,0,0">
                <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource PagerBar}" Focusable="False"/>
                <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>

        <!-- Действия в строке: ⚙ → Изменить / Скопировать / Удалить (как в Финансах) -->
        <DataTemplate x:Key="RowActions">
            <Button Style="{StaticResource IconButton}" Content="&#xF0493;" FontSize="20" ToolTip="{l:T 'Действия'}" Width="28" Height="26" MinHeight="0" Padding="0"
                    inf:Ui.DropDownMenu="True" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                <Button.ContextMenu>
                    <!-- DataContext меню — строка; команды — у справочника (Tag кнопки) -->
                    <ContextMenu Style="{StaticResource DropDownMenu}">
                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Изменить'}" inf:Ui.Icon="&#xF0CB6;"
                                  Visibility="{Binding PlacementTarget.Tag.CanEdit, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Скопировать'}" inf:Ui.Icon="&#xF018F;"
                                  Visibility="{Binding PlacementTarget.Tag.CanCreate, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        <Separator Style="{StaticResource MenuSeparator}"/>
                        <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Удалить'}" inf:Ui.Icon="&#xF09E7;" Tag="{DynamicResource DangerBrush}"
                                  Visibility="{Binding PlacementTarget.Tag.CanDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>

        <Style x:Key="CatalogGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="ItemsSource" Value="{Binding Items}"/>
            <!-- Без нумерации строк; щелчок по заголовку — сортировка загруженной страницы -->
            <Setter Property="inf:Ui.RowNumbers" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectedItem" Value="{Binding Selected}"/>
            <Setter Property="inf:Ui.RowDoubleClickCommand" Value="{Binding EditCommand}"/>
            <!-- Узкое окно: колонки не сжимаются меньше MinWidth — появляется горизонтальная прокрутка -->
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
    </UserControl.Resources>

    <TabControl>
        <TabItem Header="{l:T 'Товары и услуги'}" Visibility="{l:Can catalog.products.view}">
            <Border Style="{StaticResource Card}" DataContext="{Binding Products}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Toolbar}" Focusable="False">
                        <ContentControl.Tag>
                            <StackPanel Orientation="Horizontal">
                                <!-- Этикетка выбранного товара (вид — Настройки → Печать) -->
                                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                        ToolTip="{l:T 'Печать этикетки выбранного товара'}"
                                        Command="{Binding DataContext.PrintLabelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF04FC;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                        <TextBlock Text="{l:T 'Этикетка'}"/>
                                    </StackPanel>
                                </Button>
                                <!-- Выгрузка весовых товаров в весы TMA / CAS (вкладка «Весы») -->
                                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                        ToolTip="{l:T 'Выгрузить весовые товары во все активные весы'}"
                                        Command="{Binding DataContext.UpdateScalesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF05D1;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                        <TextBlock Text="{l:T 'Обновить весы'}"/>
                                    </StackPanel>
                                </Button>
                                <!-- Импорт / экспорт товаров (CSV для Excel) -->
                                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                        inf:Ui.DropDownMenu="True" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF0219;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                        <TextBlock Text="{l:T 'Импорт / экспорт'}"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource DropDownMenu}">
                                            <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Скачать шаблон'}" inf:Ui.Icon="&#xF0B87;"
                                                      Command="{Binding PlacementTarget.Tag.ProductsTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Импорт из файла…'}" inf:Ui.Icon="&#xF02FA;"
                                                      Visibility="{l:Can catalog.products.import}" Command="{Binding PlacementTarget.Tag.ImportProductsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator Style="{StaticResource MenuSeparator}"/>
                                            <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Экспорт в файл…'}" inf:Ui.Icon="&#xF0207;"
                                                      Command="{Binding PlacementTarget.Tag.ExportProductsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </ContentControl.Tag>
                    </ContentControl>
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"/>
                    <DataGrid Style="{StaticResource CatalogGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CellTemplate="{StaticResource RowActions}"/>
                            <!-- Миниатюра фото -->
                            <DataGridTemplateColumn Width="46" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="28" Height="28">
                                            <Border CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="&#xF0976;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Thumbnail, Converter={StaticResource Image}, ConverterParameter=64}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,28,28" RadiusX="6" RadiusY="6"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T 'Наименование'}" Binding="{Binding Name}" Width="2*" MinWidth="160"/>
                            <DataGridTemplateColumn Header="{l:T 'Тип'}" Width="80" SortMemberPath="IsService">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{l:T 'Товар'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsService}" Value="True">
                                                            <Setter Property="Text" Value="{l:T 'Услуга'}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T 'Артикул'}" Binding="{Binding Sku}" Width="110"/>
                            <DataGridTextColumn Header="{l:T 'Штрихкод'}" Binding="{Binding Barcode}" Width="140"/>
                            <DataGridTextColumn Header="{l:T 'Категория'}" Binding="{Binding Category.Name}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="{l:T 'Ед.'}" Binding="{Binding Unit}" Width="50"/>
                            <DataGridTextColumn Header="{l:T 'Закупка'}" Binding="{Binding PurchasePrice, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="{l:T 'Продажа'}" Binding="{Binding SalePrice, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="{l:T 'Активен'}" Binding="{Binding IsActive, Converter={StaticResource EnumName}}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="{l:T 'Категории'}" Visibility="{l:Can catalog.categories.view}">
            <Border Style="{StaticResource Card}" DataContext="{Binding Categories}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Toolbar}" Focusable="False"/>
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"/>
                    <DataGrid Style="{StaticResource CatalogGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CellTemplate="{StaticResource RowActions}"/>
                            <DataGridTemplateColumn Width="46" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="28" Height="28">
                                            <Border CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="&#xF0256;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Image, Converter={StaticResource Image}, ConverterParameter=64}" Stretch="UniformToFill">
                                                <Image.Clip><RectangleGeometry Rect="0,0,28,28" RadiusX="6" RadiusY="6"/></Image.Clip>
                                            </Image>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T 'Наименование'}" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="{l:T 'Описание'}" Binding="{Binding Description}" Width="2*" MinWidth="120"/>
                            <DataGridTextColumn Header="{l:T 'Активна'}" Binding="{Binding IsActive, Converter={StaticResource EnumName}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="{l:T 'Единицы'}" Visibility="{l:Can catalog.units.view}">
            <Border Style="{StaticResource Card}" DataContext="{Binding Units}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Toolbar}" Focusable="False"/>
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"/>
                    <DataGrid Style="{StaticResource CatalogGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CellTemplate="{StaticResource RowActions}"/>
                            <DataGridTextColumn Header="{l:T 'Краткое'}" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn Header="{l:T 'Полное наименование'}" Binding="{Binding Description}" Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="{l:T 'Активен'}" Binding="{Binding IsActive, Converter={StaticResource EnumName}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="{l:T 'Весы'}" Visibility="{l:Can catalog.scales.view}">
            <Border Style="{StaticResource Card}" DataContext="{Binding Scales}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Toolbar}" Focusable="False"/>
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"/>
                    <DataGrid Style="{StaticResource CatalogGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CellTemplate="{StaticResource RowActions}"/>
                            <DataGridTextColumn Header="{l:T 'Наименование'}" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="{l:T 'Тип'}" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="{l:T 'IP-адрес'}" Binding="{Binding Ip}" Width="160"/>
                            <DataGridTextColumn Header="{l:T 'Порт'}" Binding="{Binding Port}" Width="90"/>
                            <DataGridTextColumn Header="{l:T 'Активен'}" Binding="{Binding IsActive, Converter={StaticResource EnumName}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="{l:T 'Контрагенты'}" Visibility="{l:Can catalog.counterparties.view}">
            <Border Style="{StaticResource Card}" DataContext="{Binding Counterparties}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <!-- Импорт / экспорт контрагентов (CSV для Excel) -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="10,0,0,10" VerticalAlignment="Top"
                                inf:Ui.DropDownMenu="True" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF0219;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                <TextBlock Text="{l:T 'Импорт / экспорт'}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource DropDownMenu}">
                                    <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Скачать шаблон'}" inf:Ui.Icon="&#xF0B87;"
                                              Command="{Binding PlacementTarget.Tag.CounterpartiesTemplateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Импорт из файла…'}" inf:Ui.Icon="&#xF02FA;"
                                              Visibility="{l:Can catalog.counterparties.import}" Command="{Binding PlacementTarget.Tag.ImportCounterpartiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator Style="{StaticResource MenuSeparator}"/>
                                    <MenuItem Style="{StaticResource IconMenuItem}" Header="{l:T 'Экспорт в файл…'}" inf:Ui.Icon="&#xF0207;"
                                              Command="{Binding PlacementTarget.Tag.ExportCounterpartiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Toolbar}" Focusable="False"/>
                    </DockPanel>
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"/>
                    <DataGrid Style="{StaticResource CatalogGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CellTemplate="{StaticResource RowActions}"/>
                            <DataGridTextColumn Header="{l:T 'Наименование / ФИО'}" Binding="{Binding Name}" Width="2*" MinWidth="160"/>
                            <DataGridTextColumn Header="{l:T 'Группа'}" Binding="{Binding Group.Name}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="{l:T 'Телефон'}" Binding="{Binding Phone}" Width="150"/>
                            <DataGridTextColumn Header="{l:T 'Адрес'}" Binding="{Binding Address}" Width="2*" MinWidth="120"/>
                            <DataGridTextColumn Header="{l:T 'Примечание'}" Binding="{Binding Note}" Width="*" MinWidth="120"/>
                            <!-- Баланс: + контрагент должен нам (зелёный), − мы должны (красный) -->
                            <DataGridTemplateColumn Header="{l:T 'Баланс'}" Width="130" SortMemberPath="Balance">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Balance, Converter={StaticResource Money}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BalanceSign}" Value="0">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BalanceSign}" Value="-1">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T 'Активен'}" Binding="{Binding IsActive, Converter={StaticResource EnumName}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="{l:T 'Группы'}" Visibility="{l:Can catalog.groups.view}">
            <Border Style="{StaticResource Card}" DataContext="{Binding CounterpartyGroups}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Toolbar}" Focusable="False"/>
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"/>
                    <DataGrid Style="{StaticResource CatalogGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CellTemplate="{StaticResource RowActions}"/>
                            <DataGridTextColumn Header="{l:T 'Наименование'}" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="{l:T 'Описание'}" Binding="{Binding Description}" Width="2*" MinWidth="120"/>
                            <DataGridTextColumn Header="{l:T 'Активна'}" Binding="{Binding IsActive, Converter={StaticResource EnumName}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="{l:T 'Склады'}" Visibility="{l:Can catalog.warehouses.view}">
            <Border Style="{StaticResource Card}" DataContext="{Binding Warehouses}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Toolbar}" Focusable="False"/>
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"/>
                    <DataGrid Style="{StaticResource CatalogGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CellTemplate="{StaticResource RowActions}"/>
                            <DataGridTextColumn Header="{l:T 'Наименование'}" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="{l:T 'Адрес'}" Binding="{Binding Address}" Width="2*" MinWidth="120"/>
                            <DataGridTextColumn Header="{l:T 'Остаток по себестоимости'}" Binding="{Binding StockCost, Converter={StaticResource Money}}" Width="190"
                                                ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="{l:T 'Остаток по ценам продажи'}" Binding="{Binding StockSaleValue, Converter={StaticResource Money}}" Width="190"
                                                ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="{l:T 'Активен'}" Binding="{Binding IsActive, Converter={StaticResource EnumName}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="{l:T 'Кассы'}" Visibility="{l:Can catalog.cashregisters.view}">
            <Border Style="{StaticResource Card}" DataContext="{Binding CashRegisters}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Toolbar}" Focusable="False"/>
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"/>
                    <DataGrid Style="{StaticResource CatalogGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CellTemplate="{StaticResource RowActions}"/>
                            <DataGridTextColumn Header="{l:T 'Наименование'}" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="{l:T 'Остаток'}" Binding="{Binding Balance, Converter={StaticResource Money}}" Width="180" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="{l:T 'Безнал'}" Binding="{Binding IsCashless, Converter={StaticResource EnumName}}" Width="80"/>
                            <DataGridTextColumn Header="{l:T 'Активна'}" Binding="{Binding IsActive, Converter={StaticResource EnumName}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="{l:T 'Статьи'}" Visibility="{l:Can catalog.articles.view}">
            <Border Style="{StaticResource Card}" DataContext="{Binding Articles}">
                <DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource Toolbar}" Focusable="False"/>
                    <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource Pager}" Focusable="False"/>
                    <DataGrid Style="{StaticResource CatalogGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CellTemplate="{StaticResource RowActions}"/>
                            <DataGridTemplateColumn Header="{l:T 'Тип'}" Width="110" SortMemberPath="Direction">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Цветная метка: доход — зелёная, расход — красная -->
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A16A34A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="Expense">
                                                            <Setter Property="Background" Value="#1ADC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Direction, Converter={StaticResource EnumName}}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Direction}" Value="Expense">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T 'Наименование'}" Binding="{Binding Name}" Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="{l:T 'Описание'}" Binding="{Binding Description}" Width="2*" MinWidth="120"/>
                            <DataGridTextColumn Header="{l:T 'Активна'}" Binding="{Binding IsActive, Converter={StaticResource EnumName}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
