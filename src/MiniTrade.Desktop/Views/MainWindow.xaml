<Window x:Class="MiniTrade.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="TIJORAT LITE" Width="1360" Height="840" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Style="{StaticResource ChromeWindow}">
    <Window.Resources>
        <!-- Скрывать подписи, когда меню свёрнуто до иконок -->
        <Style x:Key="ExpandedOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsMenuCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- В свёрнутом меню — по центру колонки -->
        <Style x:Key="CenterWhenCollapsed" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsMenuCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопка в боковом меню (свернуть, выйти): как пункт меню -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка выхода в карточке пользователя: компактная, при наведении красная; в свёрнутом меню скрыта -->
        <Style x:Key="SignOutButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Width="34" Height="34" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsMenuCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Та же кнопка, но видна только в свёрнутом меню -->
        <Style x:Key="SignOutButtonCollapsed" TargetType="Button" BasedOn="{StaticResource SignOutButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsMenuCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════ Боковое меню: 230 px или 68 px (только иконки) ══════ -->
        <DockPanel Background="{DynamicResource SidebarBrush}">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Width" Value="230"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMenuCollapsed}" Value="True">
                            <Setter Property="Width" Value="68"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- Логотип; кнопка «свернуть / развернуть меню» — перед заголовком страницы.
                 В свёрнутом меню (68 px) — только значок. -->
            <DockPanel DockPanel.Dock="Top">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Margin" Value="15,18,8,14"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMenuCollapsed}" Value="True">
                                <Setter Property="Margin" Value="0,14,0,14"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <!-- Свёрнутое меню: только значок -->
                <Image DockPanel.Dock="Top" Source="{StaticResource LogoMark}" Width="38" Height="38" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding IsMenuCollapsed, Converter={StaticResource BoolToVis}}"/>
                <!-- Логотип tijorat.pro -->
                <Border Style="{StaticResource ExpandedOnly}" HorizontalAlignment="Left">
                    <Image Source="{StaticResource LogoFull}" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </DockPanel>

            <!-- Пользователь, лицензия, выход -->
            <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,14">
                <!-- Лицензия: «таблетка» с часами -->
                <Border CornerRadius="12" Padding="10,5" Margin="4,0,4,10" HorizontalAlignment="Left"
                        Background="{DynamicResource SidebarHoverBrush}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ExpandedOnly}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LicenseText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0150;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource WarningBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LicenseText}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Карточка пользователя: аватар, имя/роль, кнопка выхода -->
                <!-- Щелчок по карточке — окно «Мой аккаунт» (профиль, пароль, интерфейс) -->
                <Border CornerRadius="12" Padding="8" Style="{StaticResource CenterWhenCollapsed}" Cursor="Hand" ToolTip="{l:T 'Мой аккаунт'}">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenProfileCommand}"/>
                    </Border.InputBindings>
                    <Border.Background>
                        <SolidColorBrush Color="White" Opacity="0.04"/>
                    </Border.Background>
                    <DockPanel>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource PrimaryBrush}" ToolTip="{Binding UserName}">
                            <TextBlock Text="{Binding UserInitial}" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SignOutButton}" Command="{Binding SignOutCommand}"
                                ToolTip="{l:T 'Выйти из аккаунта'}" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="&#xF0343;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                        </Button>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource ExpandedOnly}">
                            <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UserRole}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Свёрнутое меню: выход отдельной кнопкой под аватаром -->
                <Button Style="{StaticResource SignOutButtonCollapsed}" Command="{Binding SignOutCommand}"
                        ToolTip="{l:T 'Выйти из аккаунта'}" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Text="&#xF0343;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                </Button>
            </StackPanel>

            <!-- Разделы -->
            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                     Margin="8,0" ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- В свёрнутом меню название раздела — во всплывающей подсказке -->
                        <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding Title}" Style="{StaticResource CenterWhenCollapsed}"
                                    ToolTipService.IsEnabled="{Binding DataContext.IsMenuCollapsed, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTipService.Placement="Right">
                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="20" Width="28" TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            <TextBlock Text="{Binding Title}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ExpandedOnly}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ══════ Содержимое ══════ -->
        <!-- Линия под строкой заголовка — на всю ширину области содержимого -->
        <Border Grid.Column="1" Height="38" VerticalAlignment="Top" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}" IsHitTestVisible="False"/>
        <!-- Заголовок страницы — прямо в строке заголовка окна (38 px, перетаскивание; справа кнопки окна) -->
        <Grid Grid.Column="1" Margin="28,0,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,120,0">
                <!-- Кнопки страницы справа от заголовка (шаблон «{Модель}.Header», см. PageHeaderSelector) -->
                <ContentControl DockPanel.Dock="Right" Content="{Binding CurrentPage}" Focusable="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                    <ContentControl.ContentTemplateSelector><l:PageHeaderSelector/></ContentControl.ContentTemplateSelector>
                </ContentControl>
                <TextBlock Text="{l:T 'Загрузка…'}" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Style="{StaticResource Muted}" Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVis}}"/>
                <!-- Кнопка «свернуть / развернуть меню» перед заголовком страницы -->
                <Button DockPanel.Dock="Left" Command="{Binding ToggleMenuCommand}" ToolTip="{Binding MenuToggleText}" Style="{StaticResource IconButton}"
                        Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" Focusable="False" WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xF035C;" FontSize="20"/>
                <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}" FontSize="16" Margin="0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" Margin="0,14,0,0"/>
        </Grid>
    </Grid>
</Window>
