<Window x:Class="MiniTrade.Desktop.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        Title="{Binding Title}" Width="680" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- «Мой аккаунт»: профиль и пароль; интерфейс этого компьютера -->
    <Grid x:Name="ShadowRoom" Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Заголовок: аватар, имя, роль -->
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,8" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть (Esc)'}"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnCancel" VerticalAlignment="Top"/>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource PrimaryBrush}" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding FullName}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="{Binding Login, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Role, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <Button Content="{l:T 'Закрыть'}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancel"
                            HorizontalAlignment="Right" MinWidth="110"/>
                </Border>

                <TabControl SelectedIndex="{Binding SelectedTab}" Margin="22,4,22,18" Background="Transparent">
                    <!-- Профиль и пароль -->
                    <TabItem Header="{l:T 'Аккаунт'}">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Данные пользователя'}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{l:T 'Логин'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Login}" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T 'Роль'}" Style="{StaticResource FieldLabel}" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T 'Телефон'}" Style="{StaticResource FieldLabel}" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding Phone}" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T 'Последний вход'}" Style="{StaticResource FieldLabel}" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding LastLogin}" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T 'Компьютер'}" Style="{StaticResource FieldLabel}" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding Machine}" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:T 'ФИО, телефон и роль меняет администратор в «Настройки → Пользователи».'}"
                                           Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T 'Смена пароля'}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{l:T 'Текущий пароль'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <PasswordBox l:PasswordBinding.Value="{Binding OldPassword}"/>
                                <TextBlock Text="{l:T 'Новый пароль'}" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox l:PasswordBinding.Value="{Binding NewPassword}"/>
                                <TextBlock Text="{l:T 'Повторите новый пароль'}" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox l:PasswordBinding.Value="{Binding NewPasswordRepeat}"/>
                                <Button Content="{l:T 'Сменить пароль'}" Margin="0,16,0,0" Command="{Binding ChangePasswordCommand}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Интерфейс: хранится на этом компьютере -->
                    <TabItem Header="{l:T 'Интерфейс'}">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{l:T 'Настройки этого компьютера. Применяются сразу.'}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>

                            <TextBlock Text="{l:T 'Тема оформления'}" Style="{StaticResource FieldLabel}"/>
                            <UniformGrid Columns="3" Margin="0,4,0,0">
                                <RadioButton Style="{StaticResource ChoiceTile}" GroupName="ptheme" Margin="0,0,8,0"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF0379;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                        <TextBlock Text="{l:T 'Системная'}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ChoiceTile}" GroupName="ptheme" Margin="4,0"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF05A8;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                        <TextBlock Text="{l:T 'Светлая'}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ChoiceTile}" GroupName="ptheme" Margin="8,0,0,0"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF0594;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                                        <TextBlock Text="{l:T 'Тёмная'}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Язык'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/>
                                    <TextBlock Text="{l:T 'Масштаб интерфейса'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:T 'Страница после входа'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding StartPages}" SelectedItem="{Binding StartPage}" DisplayMemberPath="Name"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="{l:T 'Боковое меню свёрнуто до иконок'}" IsChecked="{Binding MenuCollapsed}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
