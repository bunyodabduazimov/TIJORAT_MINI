<Window x:Class="MiniTrade.Desktop.Views.PosSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SalesViewModel}"
        Title="{l:T 'Параметры кассы'}" Width="620" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- Параметры витрины кассы: применяются сразу. Справа — видимость столбцов таблицы. -->
    <Grid x:Name="ShadowRoom" Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Заголовок -->
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,8" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogCloseButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть (Esc)'}"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnClose" VerticalAlignment="Top"/>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xF062E;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{l:T 'Параметры кассы'}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Кнопки -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <Button Content="{l:T 'Готово'}" IsDefault="True" IsCancel="True" Click="OnClose" HorizontalAlignment="Right" MinWidth="120"/>
                </Border>

                <Grid Margin="22,6,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Витрина -->
                    <StackPanel>
                        <TextBlock Text="{l:T 'Витрина'}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                        <TextBlock Text="{l:T 'Склад'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"
                                  ToolTip="{l:T 'Склад списания (остатки на витрине — по нему)'}"/>
                        <CheckBox Content="{l:T 'Только товары в наличии'}" IsChecked="{Binding OnlyInStock}" Margin="0,12,0,0"/>
                        <CheckBox Content="{l:T 'Показывать таблицей'}" IsChecked="{Binding ShowTable}" Margin="0,8,0,0"/>
                        <CheckBox Content="{l:T 'Показывать категории'}" IsChecked="{Binding ShowCategories}" Margin="0,8,0,0"/>
                        <CheckBox Content="{l:T 'Фото на карточках'}" IsChecked="{Binding ShowTilePhotos}" Margin="0,8,0,0"/>
                        <TextBlock Text="{l:T 'Размер карточек'}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding TileSizes}" SelectedValue="{Binding TileScale}" SelectedValuePath="Scale" DisplayMemberPath="Name"/>
                    </StackPanel>

                    <!-- Столбцы таблицы -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{l:T 'Столбцы таблицы'}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                        <TextBlock Text="{l:T 'Отметьте, какие столбцы показывать в режиме таблицы.'}" Style="{StaticResource Muted}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <CheckBox Content="{l:T 'Наименование'}" IsChecked="True" IsEnabled="False" Margin="0,6,0,0"/>
                        <ItemsControl x:Name="ColumnsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Title}" IsChecked="{Binding Visible}" Margin="0,8,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
