<Window x:Class="MiniTrade.Desktop.Views.PurchaseDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PurchasesViewModel}"
        Title="{Binding SelectedPurchase.Number}" Width="760" Height="640"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- Модальное окно: состав, оплаты и действия по выбранной закупке -->
    <Grid Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Заголовок -->
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,8" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть (Esc)'}"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnClose" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold"><Run Text="{l:T 'Закупка '}"/><Run Text="{Binding SelectedPurchase.Number, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                            <Run Text="{Binding SelectedPurchase.Date, Mode=OneWay, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/><Run Text=" · "/><Run Text="{Binding SelectedPurchase.Supplier.Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedPurchase.Warehouse.Name, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedPurchase.Comment}" TextWrapping="Wrap" Margin="0,4,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </DockPanel>

                <!-- Итоги и действия -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" MinHeight="36" Visibility="{l:Can purchases.return}" Command="{Binding ReturnPurchaseCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF054C;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                    <TextBlock Text="{l:T 'Возврат поставщику'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid Visibility="{l:Can purchases.pay}">
                            <Button Style="{StaticResource SuccessButton}" MinHeight="36" Margin="8,0,0,0" Command="{Binding PayDebtCommand}"
                                    Visibility="{Binding SelectedHasDebt, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF019B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                    <TextBlock Text="{l:T 'Оплатить'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            </Grid>
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="{l:T 'Сумма'}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding SelectedPurchase.Total, Mode=OneWay, Converter={StaticResource Money}}" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="{l:T 'Оплачено'}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding SelectedPurchase.PaidAmount, Mode=OneWay, Converter={StaticResource Money}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T 'Долг'}" Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding SelectedPurchase.Debt, Mode=OneWay, Converter={StaticResource Money}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!-- Оплаты по документу -->
                <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,14">
                    <TextBlock Text="{l:T 'Оплаты'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{l:T 'Оплат по документу нет'}" Style="{StaticResource Muted}"
                               Visibility="{Binding HasPayments, Converter={StaticResource InvBoolToVis}}"/>
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedPayments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, Converter={StaticResource Money}}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Date, Mode=OneWay, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/><Run Text=" · "/><Run Text="{Binding CashRegister.Name, Mode=OneWay}"/></TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Состав закупки -->
                <DataGrid ItemsSource="{Binding SelectedItems}" Margin="22,4,22,14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T 'Товар'}" Binding="{Binding Product.Name}" Width="*" MinWidth="160"/>
                        <DataGridTextColumn Header="{l:T 'Кол-во'}" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="{l:T 'Цена'}" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="{l:T 'Сумма'}" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource RightCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
