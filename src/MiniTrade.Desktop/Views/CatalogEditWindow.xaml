<Window x:Class="MiniTrade.Desktop.Views.CatalogEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        xmlns:dom="clr-namespace:MiniTrade.Core.Domain;assembly=MiniTrade.Core"
        Title="{Binding Title}" Width="480" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Формы по типу записи -->
        <!-- Товар: широкое окно, поля в две колонки -->
        <DataTemplate DataType="{x:Type dom:Product}">
            <DockPanel>
                <!-- Фото: клик — выбрать файл, можно перетащить файл мышью -->
                <StackPanel DockPanel.Dock="Left" Width="170" Margin="0,0,20,0">
                    <TextBlock Text="{l:T &apos;Фото&apos;}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <Button x:Name="PhotoBox" Height="170" Padding="0" Cursor="Hand" AllowDrop="True"
                            Command="{Binding DataContext.ChoosePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{l:T &apos;Нажмите, чтобы выбрать фото, или перетащите файл сюда&apos;}"
                            DragEnter="OnPhotoDragOver" DragOver="OnPhotoDragOver" Drop="OnPhotoDrop">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="Frame" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                                    <!-- Пустое место под фото -->
                                    <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xF0976;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="{l:T &apos;Добавить фото&apos;}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <!-- Фото, обрезанное по рамке -->
                                    <!-- Image в визуальном дереве (у ImageBrush привязка к окну не находит источник); углы скругляет Clip -->
                                    <Image x:Name="PhotoFrame" Stretch="UniformToFill" Visibility="Collapsed"
                                           Source="{Binding DataContext.PhotoImage, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,170,170" RadiusX="10" RadiusY="10"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasPhoto, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="PhotoFrame" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Empty" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Content="{l:T &apos;Выбрать…&apos;}" Style="{StaticResource SmallButton}" Margin="0,0,4,0"
                                Command="{Binding DataContext.ChoosePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="{l:T &apos;Удалить&apos;}" Style="{StaticResource SmallButton}" Margin="4,0,0,0"
                                Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </UniformGrid>
                </StackPanel>

            <!-- Тип позиции: услуга продаётся без учёта остатков на складе -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{l:T 'Тип:'}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <RadioButton Content="{l:T 'Товар'}" GroupName="ProductKind" IsChecked="{Binding IsService, Converter={StaticResource Not}}" Margin="0,0,18,0"/>
                <RadioButton x:Name="ServiceKind" Content="{l:T 'Услуга (без учёта остатков)'}" GroupName="ProductKind" IsChecked="{Binding IsService}"/>
                <CheckBox Content="{l:T 'Весовой товар'}" IsChecked="{Binding IsWeighted}" Margin="28,0,0,0" VerticalAlignment="Center"
                          ToolTip="{l:T 'Продаётся по штрихкоду весов: штрихкод товара — 5-значный код на весах'}"
                          Visibility="{Binding IsChecked, ElementName=ServiceKind, Converter={StaticResource InvBoolToVis}}"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{l:T 'Наименование *'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:T 'Категория'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0415;" ToolTip="{l:T 'Новая категория'}"
                                Visibility="{Binding DataContext.SelectedCategory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBoolToVis}}"
                                Command="{Binding DataContext.AddCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF03EB;" ToolTip="{l:T 'Изменить категорию'}"
                                Visibility="{Binding DataContext.SelectedCategory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DataContext.SelectedCategory, RelativeSource={RelativeSource AncestorType=Window}}" l:Ui.Clearable="True"
                                  l:Ui.Placeholder="{l:T 'Без категории'}"
                                  DisplayMemberPath="Name"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="{l:T 'Артикул'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="{l:T 'Штрихкод'}" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0068;" Click="OnGenerateBarcode"
                                ToolTip="{l:T 'Сгенерировать штрихкод (весовой — свободный код весов 1–99999, иначе EAN-13)'}"/>
                        <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{l:T 'Цена закупки'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox l:Ui.Numeric="True" Text="{Binding PurchasePrice, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="{l:T 'Розничная цена'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox l:Ui.Numeric="True" Text="{Binding SalePrice, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="{l:T 'Оптовая цена'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox l:Ui.Numeric="True" ToolTip="{l:T 'Если не задана — при продаже оптом берётся розничная цена'}"
                             Text="{Binding WholesalePrice, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="{l:T 'Ед. измерения'}" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0415;" ToolTip="{l:T 'Новая единица измерения'}"
                                Visibility="{Binding DataContext.SelectedUnit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBoolToVis}}"
                                Command="{Binding DataContext.AddUnitCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF03EB;" ToolTip="{l:T 'Изменить единицу измерения'}"
                                Visibility="{Binding DataContext.SelectedUnit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.EditUnitCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <ComboBox ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DataContext.SelectedUnit, RelativeSource={RelativeSource AncestorType=Window}}" l:Ui.Clearable="True"
                                  DisplayMemberPath="Name"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2"
                            Visibility="{Binding IsChecked, ElementName=ServiceKind, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="{l:T 'Мин. остаток'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox l:Ui.Numeric="True" Text="{Binding MinStock, Converter={StaticResource Dec}, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <CheckBox Grid.Row="5" Grid.ColumnSpan="3" Content="{l:T 'Активен (доступен для выбора в документах)'}" IsChecked="{Binding IsActive}" Margin="0,14,0,0"/>
            </Grid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dom:Category}">
            <StackPanel>
                <!-- Картинка категории (показывается на кассе): клик — выбрать, можно перетащить файл -->
                <DockPanel Margin="0,0,0,10">
                    <Button Width="72" Height="72" Padding="0" Cursor="Hand" AllowDrop="True" DockPanel.Dock="Left"
                            Command="{Binding DataContext.ChoosePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{l:T 'Нажмите, чтобы выбрать картинку, или перетащите файл сюда'}"
                            DragEnter="OnPhotoDragOver" DragOver="OnPhotoDragOver" Drop="OnPhotoDrop">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="Frame" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                                    <TextBlock x:Name="Empty" Text="&#xF0976;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                    <Image x:Name="PhotoFrame" Stretch="UniformToFill" Visibility="Collapsed"
                                           Source="{Binding DataContext.PhotoImage, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Image.Clip><RectangleGeometry Rect="0,0,72,72" RadiusX="10" RadiusY="10"/></Image.Clip>
                                    </Image>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasPhoto, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="PhotoFrame" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Empty" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{l:T 'Картинка'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:T 'Выбрать…'}" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                    Command="{Binding DataContext.ChoosePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="{l:T 'Удалить'}" Style="{StaticResource SmallButton}"
                                    Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{l:T 'Наименование *'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{l:T 'Описание'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="{l:T 'Активна'}" IsChecked="{Binding IsActive}" Margin="0,14,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- Группа контрагентов -->
        <DataTemplate DataType="{x:Type dom:CounterpartyGroup}">
            <StackPanel>
                <TextBlock Text="{l:T 'Наименование *'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{l:T 'Описание'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="{l:T 'Активна'}" IsChecked="{Binding IsActive}" Margin="0,14,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- Контрагент: покупатель и/или поставщик, разделение по группам -->
        <DataTemplate DataType="{x:Type dom:Counterparty}">
            <StackPanel>
                <TextBlock Text="{l:T 'Наименование / ФИО *'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{l:T 'Группа'}" Style="{StaticResource FieldLabel}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF0415;" ToolTip="{l:T 'Новая группа контрагентов'}"
                            Visibility="{Binding DataContext.SelectedGroup, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBoolToVis}}"
                            Command="{Binding DataContext.AddGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource InputAddonButton}" Content="&#xF03EB;" ToolTip="{l:T 'Изменить группу'}"
                            Visibility="{Binding DataContext.SelectedGroup, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.EditGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <ComboBox ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.SelectedGroup, RelativeSource={RelativeSource AncestorType=Window}}" l:Ui.Clearable="True"
                              DisplayMemberPath="Name"/>
                </DockPanel>
                <TextBlock Text="{l:T 'Телефон'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{l:T 'Адрес'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{l:T 'Примечание'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="{l:T 'Активен'}" IsChecked="{Binding IsActive}" Margin="0,14,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dom:MeasureUnit}">
            <StackPanel>
                <TextBlock Text="{l:T 'Краткое наименование *'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" l:Ui.Placeholder="{l:T 'шт, кг, л…'}"/>
                <TextBlock Text="{l:T 'Полное наименование'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" l:Ui.Placeholder="{l:T 'Штука, килограмм, литр…'}"/>
                <CheckBox Content="{l:T 'Активна'}" IsChecked="{Binding IsActive}" Margin="0,14,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dom:ScaleDevice}">
            <StackPanel>
                <TextBlock Text="{l:T 'Наименование *'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" l:Ui.Placeholder="{l:T 'Весы мясного отдела'}"/>
                <TextBlock Text="{l:T 'Тип весов'}" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <RadioButton Content="TMA" GroupName="scaleType" Margin="0,0,20,0" Tag="4001" Click="OnScaleTypeClick"
                                 IsChecked="{Binding Type, Converter={StaticResource Equals}, ConverterParameter=Tma}"/>
                    <RadioButton Content="CAS" GroupName="scaleType" Margin="0,0,20,0" Tag="20304" Click="OnScaleTypeClick"
                                 IsChecked="{Binding Type, Converter={StaticResource Equals}, ConverterParameter=Cas}"/>
                    <RadioButton x:Name="RongtaRadio" Content="Rongta" GroupName="scaleType" Click="OnRongtaClick"
                                 IsChecked="{Binding Type, Converter={StaticResource Equals}, ConverterParameter=Rongta}"/>
                </StackPanel>
                <!-- Rongta: файл PLU для программы RLS1000 вместо сети -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=RongtaRadio, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{l:T 'Файл PLU (программа RLS1000)'}" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ScaleFileBox" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" l:Ui.Placeholder="C:\RLS1000\plu.Txp"/>
                    <TextBlock Text="{l:T 'Программа запишет в этот файл товары, а программа весов RLS1000 загрузит их в весы. Пусто — C:\\RLS1000\\plu.Txp.'}"
                               Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsChecked, ElementName=RongtaRadio, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="{l:T 'IP-адрес *'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" l:Ui.Placeholder="192.168.1.50"/>
                <TextBlock Text="{l:T 'Порт *'}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ScalePortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{l:T 'Обычно: TMA — 4001, CAS — 20304.'}" Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Left" Style="{StaticResource SmallButton}" Content="{l:T 'Проверить связь'}"
                            Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"
                               Text="{Binding DataContext.TestMessage, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.TestOk, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.TestOk, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                </StackPanel>
                <CheckBox Content="{l:T 'Активны'}" IsChecked="{Binding IsActive}" Margin="0,14,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dom:Warehouse}">
            <StackPanel>
                <TextBlock Text="{l:T 'Наименование *'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{l:T 'Адрес'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="{l:T 'Активен'}" IsChecked="{Binding IsActive}" Margin="0,14,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dom:FinanceArticle}">
            <StackPanel>
                <TextBlock Text="{l:T 'Тип статьи'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{l:T 'Доход'}" GroupName="articleDirection" Margin="0,0,20,0"
                                 IsChecked="{Binding Direction, Converter={StaticResource Equals}, ConverterParameter=Income}"/>
                    <RadioButton Content="{l:T 'Расход'}" GroupName="articleDirection"
                                 IsChecked="{Binding Direction, Converter={StaticResource Equals}, ConverterParameter=Expense}"/>
                </StackPanel>
                <TextBlock Text="{l:T 'Наименование *'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{l:T 'Описание'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="{l:T 'Активна'}" IsChecked="{Binding IsActive}" Margin="0,14,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dom:CashRegister}">
            <StackPanel>
                <TextBlock Text="{l:T 'Наименование *'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{l:T 'Остаток'}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Balance, Converter={StaticResource Money}, Mode=OneWay}" IsReadOnly="True" Focusable="False"/>
                <TextBlock Text="{l:T 'Остаток меняется только операциями в разделе «Финансы».'}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                <CheckBox Content="{l:T 'Безналичная касса (карта, перевод)'}" IsChecked="{Binding IsCashless}" Margin="0,14,0,0"/>
                <TextBlock Text="{l:T 'Оплата в эту кассу пробивается на ККТ как безналичная.'}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <CheckBox Content="{l:T 'Активна'}" IsChecked="{Binding IsActive}" Margin="0,14,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Поля по краям — место для тени -->
    <Grid x:Name="ShadowRoom" Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Заголовок (за него можно перетаскивать окно) -->
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,6" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogCloseButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть (Esc)'}"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnCancel" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Кнопки -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <DockPanel>
                        <Button Content="{l:T 'Удалить'}" Style="{StaticResource DangerGhostButton}" Command="{Binding DeleteCommand}"
                                Visibility="{Binding IsNew, Converter={StaticResource InvBoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{l:T 'Отмена'}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancel" MinWidth="96"/>
                            <Button Content="{l:T 'Сохранить'}" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="120" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Ошибка -->
                <Border DockPanel.Dock="Bottom" Margin="22,0,22,14" Padding="12,8" CornerRadius="6" Background="{DynamicResource DangerLightBrush}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Text="&#xF05D6;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource DangerBrush}" Margin="0,2,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <ContentControl x:Name="Form" Content="{Binding Item}" Focusable="False" Margin="22,4,22,18"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
