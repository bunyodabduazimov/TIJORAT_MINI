<Window x:Class="MiniTrade.Desktop.Views.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Width="480" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- Модальное окно фильтра журнала кассовых операций -->
    <Grid x:Name="ShadowRoom" Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Заголовок -->
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,8" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть (Esc)'}"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnCancel" VerticalAlignment="Top"/>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xF0236;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Кнопки -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <DockPanel>
                        <Button Content="{l:T 'Сбросить'}" Style="{StaticResource GhostButton}" Command="{Binding ResetCommand}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{l:T 'Отмена'}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancel" MinWidth="96"/>
                            <Button Content="{l:T 'Применить'}" IsDefault="True" Command="{Binding ApplyCommand}" Margin="8,0,0,0" MinWidth="120"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Поля фильтра — по типу модели: журнал операций или журнал продаж -->
                <ContentControl Content="{Binding}" Margin="22,4,22,18" Focusable="False">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:FinanceFilterViewModel}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Касса'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding CashChoices}" SelectedItem="{Binding Cash}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Тип операции'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding DirectionChoices}" SelectedItem="{Binding Direction}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Контрагент'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CounterpartyChoices}" SelectedItem="{Binding Counterparty}" DisplayMemberPath="Name"/>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SalesFilterViewModel}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Склад'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding WarehouseChoices}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Касса'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CashChoices}" SelectedItem="{Binding Cash}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Покупатель'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CustomerChoices}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name"/>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ProductFilterViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Категория'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding Category}" DisplayMemberPath="Name"/>
                                    <TextBlock Text="{l:T 'Тип'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding Type}" DisplayMemberPath="Name"/>
                                    <TextBlock Text="{l:T 'Штрихкод'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding BarcodeChoices}" SelectedItem="{Binding Barcode}" DisplayMemberPath="Name"/>
                                    <TextBlock Text="{l:T 'Активность'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding ActiveChoices}" SelectedItem="{Binding Active}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:T 'Ед. измерения'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding Unit}" DisplayMemberPath="Name"/>
                                    <TextBlock Text="{l:T 'Весовой'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding WeightedChoices}" SelectedItem="{Binding Weighted}" DisplayMemberPath="Name"/>
                                    <TextBlock Text="{l:T 'Фото'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PhotoChoices}" SelectedItem="{Binding Photo}" DisplayMemberPath="Name"/>
                                    <TextBlock Text="{l:T 'Удалённые'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding DeletedChoices}" SelectedItem="{Binding Deleted}" DisplayMemberPath="Name"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AuditFilterViewModel}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Пользователь'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding UserChoices}" SelectedItem="{Binding User}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Действие'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ActionChoices}" SelectedItem="{Binding Action}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Компьютер'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding MachineChoices}" SelectedItem="{Binding Machine}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Объект'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ObjectChoices}" SelectedItem="{Binding Object}" DisplayMemberPath="Name"/>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PurchasesFilterViewModel}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Поставщик'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SupplierChoices}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Склад'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding WarehouseChoices}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"/>
                                <CheckBox Content="{l:T 'Только неоплаченные (с долгом)'}" IsChecked="{Binding OnlyWithDebt}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                        <!-- Фильтр отчётов: пустое поле — «все», «×» сбрасывает выбор -->
                        <DataTemplate DataType="{x:Type vm:ReportsFilterViewModel}">
                            <StackPanel>
                                <StackPanel Visibility="{Binding WarehouseVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{l:T 'Склад'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"
                                              l:Ui.Placeholder="{l:T 'Все склады'}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding UserVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{l:T 'Пользователь'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding User}" DisplayMemberPath="Name"
                                              l:Ui.Placeholder="{l:T 'Все пользователи'}"/>
                                    <TextBlock Text="{l:T 'Контрагент'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Counterparties}" SelectedItem="{Binding Counterparty}" DisplayMemberPath="Name"
                                              l:Ui.Placeholder="{l:T 'Все контрагенты'}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ProductVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{l:T 'Товар'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding Product}" DisplayMemberPath="Name"
                                              l:Ui.Placeholder="{l:T 'Все товары'}"/>
                                    <TextBlock Text="{l:T 'Категория'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name"
                                              l:Ui.Placeholder="{l:T 'Все категории'}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
