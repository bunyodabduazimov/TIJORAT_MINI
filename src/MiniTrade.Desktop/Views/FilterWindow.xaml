<Window x:Class="MiniTrade.Desktop.Views.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MiniTrade.Desktop.Infrastructure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Width="480" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- Модальное окно фильтра журнала кассовых операций -->
    <Grid x:Name="ShadowRoom" Margin="20">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Effect="{DynamicResource DialogShadow}"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <DockPanel>
                <!-- Заголовок -->
                <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="22,16,12,8" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF0156;" ToolTip="{l:T 'Закрыть (Esc)'}"
                            Width="30" Height="30" IsTabStop="False" Focusable="False" Click="OnCancel" VerticalAlignment="Top"/>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xF0236;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Кнопки -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,12">
                    <DockPanel>
                        <Button Content="{l:T 'Сбросить'}" Style="{StaticResource GhostButton}" Command="{Binding ResetCommand}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{l:T 'Отмена'}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancel" MinWidth="96"/>
                            <Button Content="{l:T 'Применить'}" IsDefault="True" Command="{Binding ApplyCommand}" Margin="8,0,0,0" MinWidth="120"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Поля фильтра — по типу модели: журнал операций или журнал продаж -->
                <ContentControl Content="{Binding}" Margin="22,4,22,18" Focusable="False">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:FinanceFilterViewModel}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Касса'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding CashChoices}" SelectedItem="{Binding Cash}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Тип операции'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding DirectionChoices}" SelectedItem="{Binding Direction}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Контрагент'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CounterpartyChoices}" SelectedItem="{Binding Counterparty}" DisplayMemberPath="Name"/>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SalesFilterViewModel}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Склад'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding WarehouseChoices}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Касса'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CashChoices}" SelectedItem="{Binding Cash}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Покупатель'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CustomerChoices}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name"/>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PurchasesFilterViewModel}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Поставщик'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SupplierChoices}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{l:T 'Склад'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding WarehouseChoices}" SelectedItem="{Binding Warehouse}" DisplayMemberPath="Name"/>
                                <CheckBox Content="{l:T 'Только неоплаченные (с долгом)'}" IsChecked="{Binding OnlyWithDebt}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
