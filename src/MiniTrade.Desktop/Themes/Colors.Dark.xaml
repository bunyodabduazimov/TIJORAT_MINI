<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тёмная палитра. Ключи совпадают с Colors.Light.xaml. -->
    <Color x:Key="PrimaryColor">#3B7BF2</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B7BF2"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#A8C4FF"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#1D2D52"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#663B7BF2"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0B0F19"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1A2133"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#A3ADC2"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F1420"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171D2B"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1C2333"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#262F42"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#323C53"/>
    <SolidColorBrush x:Key="InputHoverBrush" Color="#4A5672"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#1A2030"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5D6880"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#68738C"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#4F5970"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E6EAF2"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#98A2B8"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F05252"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#3A1E25"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#123524"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="#1B2A4A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#1E2638"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#39435A"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#525E7A"/>
    <!-- В тёмной теме кнопки при наведении светлеют -->
    <SolidColorBrush x:Key="ShadeBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TooltipBrush" Color="#2B3448"/>

    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000"/>
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.6" Color="#000000"/>
    <DropShadowEffect x:Key="MenuShadow" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1C2333"/>
</ResourceDictionary>
