<Application x:Class="MiniTrade.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MiniTrade.Desktop.ViewModels"
             xmlns:v="clr-namespace:MiniTrade.Desktop.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Палитра (светлая/тёмная) — ThemeManager подменяет этот словарь на лету -->
                <ResourceDictionary Source="Themes/Colors.Light.xaml"/>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
                <!-- Кнопки справа от заголовка страниц -->
                <ResourceDictionary Source="Views/PageHeaders.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel → View (MVVM навигация) -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FinanceViewModel}"><v:FinanceView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesViewModel}"><v:SalesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PurchasesViewModel}"><v:PurchasesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WarehouseViewModel}"><v:WarehouseView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CatalogViewModel}"><v:CatalogView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditLogViewModel}"><v:AuditLogView/></DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
