@page "/admin/login"
@model LoginModel
@{ ViewData["Title"] = "Вход"; }
<div class="card login-card">
    <div class="brand" style="flex-direction:column;align-items:flex-start"><img src="~/img/logo-full.png" alt="tijorat.pro" style="width:100%;max-width:300px" /><small>Панель администратора лицензий</small></div>
    @if (Model.Error is not null) { <div class="alert alert-err">@Model.Error</div> }
    <form method="post">
        <div style="margin-bottom:12px"><label>Логин</label><input asp-for="Username" autofocus /></div>
        <div style="margin-bottom:18px"><label>Пароль</label><input asp-for="Password" type="password" /></div>
        <button class="btn" style="width:100%" type="submit">Войти</button>
    </form>
</div>
